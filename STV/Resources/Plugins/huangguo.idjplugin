{
 "manifest": {
  "schema": 1,
  "id": "com.idj.bundled.huangguo",
  "name": "黄果",
  "version": "1.0.0",
  "author": {
   "name": "i短剧"
  },
  "description": "黄果 18+ 短剧（AI 站 / 视频站 / App 源三合一，含镜像探测与访客会话）",
  "type": "shortdrama",
  "adult": true,
  "language": [
   "zh"
  ],
  "minAppVersion": "1.5",
  "entry": "main.js",
  "permissions": {
   "http": [
    "*.adihsppe.cc",
    "hgai12.com",
    "*.hgai12.com",
    "huangguoai.com",
    "huangguoai.io",
    "huangguoai.me",
    "huangguoai.ai",
    "*.agdkczeyx.cc",
    "*.ediayikma.cc",
    "huangguo.video",
    "*.huangguo.video",
    "*.cloudfront.net",
    "*.lkkwip.cn"
   ],
   "media": [
    "*.adihsppe.cc",
    "*.drleao.cn",
    "huangguo.video",
    "*.huangguo.video",
    "*.cloudfront.net",
    "*.lkkwip.cn",
    "*.m3u8.cdn",
    "*.hgai12.com",
    "*.eisees.com",
    "*.r2.dev",
    "*.cloudflarestorage.com"
   ],
   "cloudflare": true,
   "storage": true,
   "login": false
  },
  "capabilities": [
   "home",
   "category",
   "search",
   "detail",
   "play"
  ],
  "settings": [],
  "integrity": {
   "files": {
    "main.js": "sha256-5VOp2B6/+KBcmLs+xerETQfhnewGht74H9UFqFhtVcI="
   }
  }
 },
 "files": {
  "main.js": "// 黄果 · i短剧 idj1 18+ 短剧插件（AI 站 / 视频站 / App 源）\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_7 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/26.6 Mobile/15E148 Safari/604.1';\nconst AI_MIRRORS = [\n  'https://00b4b.adihsppe.cc', 'https://bsl8m.adihsppe.cc', 'https://hgai12.com',\n  'https://brma.adihsppe.cc', 'https://mzofzp.adihsppe.cc', 'https://rpb7bz.adihsppe.cc',\n  'https://v2tg.adihsppe.cc', 'https://huangguoai.com', 'https://huangguoai.io',\n  'https://huangguoai.me', 'https://huangguoai.ai', 'https://thu.agdkczeyx.cc', 'https://ttvoij.ediayikma.cc'\n];\nconst VIDEO_BASE = 'https://huangguo.video';\nconst FRONTEND_URL = 'https://d2pypzndaqisk.cloudfront.net';\nconst API_HOSTS = [\n  'https://dr6skssi3nxbk.cloudfront.net',\n  'https://d18ka9rqpfd3lo.cloudfront.net',\n  'https://d37n0wjehmw08f.cloudfront.net'\n];\nconst CDN_URL = 'https://sjljsla.lkkwip.cn';\nconst LEGACY_XUA = 'BuildID=com.abc.Butterfly;SysType=ios;DevID=00000000000000000000000000000;Ver=1.0.0;DevType=iPhone;DeviceBrand=APPLE;DeviceModel=iPhone;SystemName=iOS;SystemVersion=18.7;Terminal=1;IsH5=1;Sid=00000000000000000000000000000000';\n\nconst NON_CONSENT = [\n  '强奸', '強姦', '强暴', '強暴', '迷奸', '迷姦', '轮奸', '輪姦', '下药', '下藥', '迷药', '迷藥',\n  '催眠', '胁迫', '脅迫', '强迫', '強迫', '被迫', '肉偿', '肉償', '凌辱', '侵犯', '猥亵', '猥褻',\n  '非自愿', '囚禁', '绑架', '綁架', '偷拍', '盗摄', '醉奸', '睡奸', '性奴', '调教', '調教',\n  'rape', 'forced', 'drugged', 'hypno'\n];\n\nconst CATEGORIES = [\n  { id: 'ai:recommend', name: 'AI精选' },\n  { id: 'ai:newest', name: 'AI上新' },\n  { id: 'ai:hot', name: 'AI热播榜', isRank: true },\n  { id: 'ai:ai-duanju', name: 'AI短剧' },\n  { id: 'ai:ai-manju', name: 'AI漫剧' },\n  { id: 'ai:ai-mogai', name: 'AI魔改' },\n  { id: 'video:0', name: '视频站全部' },\n  { id: 'video:1', name: 'MV/音乐剧' },\n  { id: 'video:2', name: '短片' },\n  { id: 'video:3', name: '连续剧' },\n  { id: 'video:4', name: '片段' }\n];\n\nlet aiBaseCache = null;\nlet legacyApiCache = null;\nlet legacyAccessCache = null;\nlet imageCdnCache = 'https://zzzznnn.lkkwip.cn';\n\nfunction isBlocked(title, remarks) {\n  const s = (String(title || '') + ' ' + String(remarks || '')).toLowerCase();\n  for (let i = 0; i < NON_CONSENT.length; i++) if (s.indexOf(NON_CONSENT[i]) >= 0) return true;\n  return false;\n}\n\nfunction unescapeHtml(s) {\n  return String(s || '')\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#0?39;/g, \"'\").replace(/&#x27;/gi, \"'\")\n    .replace(/&nbsp;/g, ' ').replace(/\\\\\\//g, '/');\n}\n\nfunction cleanText(s) {\n  return unescapeHtml(String(s || '').replace(/<[^>]*>/g, ' ')).replace(/\\s+/g, ' ').trim();\n}\n\nfunction absUrl(base, u) {\n  u = unescapeHtml(u).trim();\n  if (!u || /^(?:data|javascript|about):/i.test(u)) return '';\n  if (u.startsWith('//')) return 'https:' + u;\n  if (/^http:\\/\\//i.test(u)) return 'https://' + u.slice(7);\n  if (/^https:\\/\\//i.test(u)) return u;\n  return host.url.resolve(base.endsWith('/') ? base : base + '/', u);\n}\n\nfunction cleanId(s) {\n  return String(s || '').trim().replace(/^\\/+|\\/+$/g, '').split(/[?#]/)[0];\n}\n\nfunction epIndex(title, fallback) {\n  const m = String(title || '').match(/第\\s*(\\d+)\\s*[集话期]/);\n  if (m) return parseInt(m[1], 10);\n  const m2 = String(title || '').match(/(?:ep|episode)[\\s._-]*(\\d+)/i);\n  if (m2) return parseInt(m2[1], 10);\n  return fallback;\n}\n\nasync function httpGet(url, referer, extraHeaders) {\n  const headers = Object.assign({ 'User-Agent': UA, 'Referer': referer, 'Accept-Language': 'zh-CN,zh;q=0.9' }, extraHeaders || {});\n  const res = await host.http.request({ url, headers, timeout: 15000 });\n  if (res.status < 200 || res.status >= 300) throw host.error('E_HTTP', 'HTTP ' + res.status);\n  return res;\n}\n\nasync function ensureAIBase() {\n  if (aiBaseCache) return aiBaseCache;\n  const saved = host.storage.get('aiBase');\n  const savedMirrors = host.storage.get('aiMirrors');\n  const cands = [];\n  const push = (u) => { if (u && cands.indexOf(u) < 0) cands.push(u); };\n  if (typeof saved === 'string') push(saved);\n  if (Array.isArray(savedMirrors)) savedMirrors.forEach(push);\n  AI_MIRRORS.forEach(push);\n  for (const m of cands) {\n    if (!host.http.allowed(m + '/')) continue;\n    try {\n      const r = await host.http.request({ url: m + '/api/videos/category/ai-duanju?sort=hot&page=1&size=1', headers: { 'User-Agent': UA, 'Referer': m + '/' }, timeout: 8000 });\n      if (r.status === 200) {\n        const j = JSON.parse(r.body);\n        if (j && j.data && Array.isArray(j.data.items)) {\n          const finalUrl = r.url || m;\n          const om = finalUrl.match(/^(https:\\/\\/[^/]+)/i);\n          aiBaseCache = om ? om[1] : m;\n          host.storage.set('aiBase', aiBaseCache);\n          return aiBaseCache;\n        }\n      }\n    } catch (_) {}\n  }\n  throw host.error('E_NETWORK', '黄果 AI 站镜像均不可用');\n}\n\nfunction aiJsonCards(obj, base) {\n  const out = [], seen = {};\n  function walk(v) {\n    if (Array.isArray(v)) { v.forEach(walk); return; }\n    if (!v || typeof v !== 'object') return;\n    if (v.id != null) {\n      let id = cleanId(v.id || v.videoId || v.slug);\n      const dm = id.match(/\\/detail\\/([^/?#]+)/);\n      if (dm) id = cleanId(dm[1]);\n      const title = String(v.title || v.name || v.videoTitle || '').trim();\n      if (id && title && !seen[id] && !isBlocked(title, v.remark)) {\n        seen[id] = 1;\n        const cov = v.cover || v.coverUrl || v.cover_url || v.coverImage || v.image || v.thumbnail || v.poster || '';\n        const eps = Number(v.episode_count || v.episodeCount || v.total_episodes || v.totalEpisodes || v.episodes || 0);\n        out.push({\n          id: 'ai:' + id,\n          title,\n          cover: absUrl(base + '/', cov),\n          remarks: String(v.remark || v.vod_remarks || (eps > 0 ? `全${eps}集` : '')).trim(),\n          orientation: 'portrait'\n        });\n      }\n      return;\n    }\n    for (const k of Object.keys(v)) walk(v[k]);\n  }\n  walk(obj);\n  return out;\n}\n\nfunction parseAICards(html, pageUrl) {\n  const out = [], seen = {};\n  const doc = host.html.parse(html, pageUrl);\n  for (const card of doc.select('.hg-drama-card')) {\n    let id = cleanId(card.attr('data-track-id'));\n    const a = card.selectFirst('a[href*=\"/detail/\"]') || card.selectFirst('a[href*=\"/video/\"]');\n    if (!id && a) {\n      const m = a.attr('href').match(/\\/(?:detail|video)\\/([^/?#]+)/);\n      if (m) id = cleanId(m[1]);\n    }\n    if (!id || seen[id]) continue;\n    const tEl = card.selectFirst('.hg-drama-card__title');\n    const title = (card.attr('data-track-title') || (tEl && tEl.text()) || (a && (a.attr('title') || a.text())) || '').trim();\n    if (!title || isBlocked(title, '')) continue;\n    seen[id] = 1;\n    const img = card.selectFirst('img');\n    const cover = img ? absUrl(pageUrl, img.attr('data-src') || img.attr('data-original') || img.attr('src')) : '';\n    const epEl = card.selectFirst('.hg-drama-card__episode');\n    out.push({ id: 'ai:' + id, title, cover, remarks: epEl ? epEl.text().trim() : '', orientation: 'portrait' });\n  }\n  if (!out.length) {\n    for (const a of doc.select('a[href*=\"/detail/\"]')) {\n      const m = a.attr('href').match(/\\/detail\\/([^/?#]+)/);\n      const id = m ? cleanId(m[1]) : '';\n      const title = (a.attr('title') || a.text()).trim();\n      if (!id || !title || seen[id] || isBlocked(title, '')) continue;\n      seen[id] = 1;\n      const img = a.selectFirst('img');\n      out.push({ id: 'ai:' + id, title, cover: img ? absUrl(pageUrl, img.attr('data-src') || img.attr('src')) : '', orientation: 'portrait' });\n    }\n  }\n  return out;\n}\n\nfunction parseRankJsonLd(html, slug, base) {\n  const covers = {};\n  const re = /href=[\"']([^\"']*\\/video\\/(\\d+)[^\"']*)[\"']/gi;\n  let m;\n  while ((m = re.exec(html)) !== null) {\n    const id = m[2];\n    if (covers[id]) continue;\n    const win = html.slice(m.index, m.index + 1200);\n    const cm = win.match(/https:\\/\\/pic\\.drleao\\.cn[^\"\\s<>]+/i);\n    if (cm) covers[id] = cm[0];\n  }\n  const ldRe = /<script[^>]*ld\\+json[^>]*>([\\s\\S]*?)<\\/script>/gi;\n  while ((m = ldRe.exec(html)) !== null) {\n    try {\n      const o = JSON.parse(unescapeHtml(m[1]));\n      const graph = Array.isArray(o['@graph']) ? o['@graph'] : [];\n      for (const g of graph) {\n        if (g['@type'] === 'ItemList' && String(g['@id'] || '').endsWith(`/ranks/${slug}/#itemlist`)) {\n          return (g.itemListElement || []).map(e => {\n            const um = String(e.url || '').match(/\\/(?:detail|video)\\/([^/?#]+)/);\n            const id = um ? cleanId(um[1]) : '';\n            const title = String(e.name || '').trim();\n            if (!id || !title || isBlocked(title, '')) return null;\n            return { id: 'ai:' + id, title, cover: covers[id] || '', orientation: 'portrait' };\n          }).filter(Boolean);\n        }\n      }\n    } catch (_) {}\n  }\n  return [];\n}\n\nfunction parseVideoCards(html, pageUrl) {\n  const doc = host.html.parse(html, pageUrl);\n  const cards = doc.select('article.video-card');\n  const nodes = cards.length ? cards : doc.select('a[href*=\"/series/\"], a[href*=\"/video/\"]');\n  const out = [], seen = {};\n  for (const n of nodes) {\n    const a = n.selectFirst('a[href*=\"/series/\"], a[href*=\"/video/\"]') || n;\n    const href = a.attr('href') || '';\n    const m = href.match(/\\/(series|video)\\/([^/?#]+)/);\n    if (!m) continue;\n    const sid = m[1] + '/' + cleanId(m[2]);\n    if (seen[sid]) continue;\n    const img = n.selectFirst('img');\n    const title = (a.attr('title') || (img && img.attr('alt')) || a.text() || '').trim();\n    if (!title || isBlocked(title, '')) continue;\n    seen[sid] = 1;\n    const cover = img ? absUrl(pageUrl, img.attr('data-src') || img.attr('data-original') || img.attr('src')) : '';\n    const sub = n.selectFirst('.text-gold-dim');\n    out.push({ id: 'video:' + sid, title, cover, remarks: sub ? sub.text().trim() : '' });\n  }\n  return out;\n}\n\nfunction splitId(raw) {\n  const i = String(raw || '').indexOf(':');\n  if (i > 0) return [raw.slice(0, i), raw.slice(i + 1)];\n  return ['ai', String(raw || '')];\n}\n\nexport default {\n  async home() {\n    const p = await this.category({ id: 'ai:recommend', page: 1 });\n    return { categories: CATEGORIES, items: p.items, hasMore: p.hasMore };\n  },\n\n  async category({ id = 'ai:recommend', page = 1 }) {\n    const p = Math.max(1, Number(page) || 1);\n    const [sub, slug] = splitId(id);\n    if (sub === 'ai') {\n      const base = await ensureAIBase();\n      if (slug === 'hot') {\n        if (p > 1) return { items: [], hasMore: false };\n        const r = await httpGet(`${base}/ranks/hot/`, base + '/');\n        return { items: parseRankJsonLd(r.body, 'hot', base), hasMore: false };\n      }\n      if (slug.startsWith('ai-')) {\n        try {\n          const r = await httpGet(`${base}/api/videos/category/${slug}?sort=hot&page=${p}&size=24`, `${base}/${slug}/`);\n          const items = aiJsonCards(JSON.parse(r.body), base);\n          return { items, hasMore: items.length >= 24 };\n        } catch (_) {\n          if (p > 1) return { items: [], hasMore: false };\n          const r = await httpGet(`${base}/${slug}/`, base + '/');\n          return { items: parseAICards(r.body, `${base}/${slug}/`), hasMore: false };\n        }\n      }\n      const u = `${base}/${slug}/${p}/`;\n      const r = await httpGet(u, base + '/');\n      const items = parseAICards(r.body, u);\n      return { items, hasMore: items.length > 0 };\n    }\n    if (sub === 'video') {\n      const q = [];\n      if (slug && slug !== '0') q.push('category=' + encodeURIComponent(slug));\n      if (p > 1) q.push('page=' + p);\n      const u = VIDEO_BASE + '/videos' + (q.length ? '?' + q.join('&') : '');\n      const r = await httpGet(u, VIDEO_BASE + '/');\n      const items = parseVideoCards(r.body, u);\n      return { items, hasMore: items.length > 0 };\n    }\n    return { items: [], hasMore: false };\n  },\n\n  async search({ keyword, page = 1 }) {\n    const p = Math.max(1, Number(page) || 1);\n    const q = encodeURIComponent(String(keyword || '').trim());\n    if (!q) return { items: [], hasMore: false };\n    const out = [], seen = {};\n    const add = (list) => { for (const x of list) if (!seen[x.id]) { seen[x.id] = 1; out.push(x); } };\n    try {\n      const base = await ensureAIBase();\n      const r = await httpGet(`${base}/api/search?q=${q}&page=${p}&size=24`, base + '/');\n      add(aiJsonCards(JSON.parse(r.body), base));\n    } catch (_) {}\n    if (p === 1) {\n      try {\n        const u = `${VIDEO_BASE}/search?q=${q}`;\n        const r = await httpGet(u, VIDEO_BASE + '/');\n        add(parseVideoCards(r.body, u));\n      } catch (_) {}\n    }\n    return { items: out, hasMore: out.length >= 24 };\n  },\n\n  async detail({ id }) {\n    const [sub, sid] = splitId(id);\n    if (sub === 'ai') {\n      const base = await ensureAIBase();\n      const pageUrl = `${base}/video/${sid}/`;\n      const r = await httpGet(pageUrl, base + '/');\n      const h = r.body;\n      const doc = host.html.parse(h, pageUrl);\n      const titleEl = doc.selectFirst('title');\n      const title = (titleEl ? titleEl.text().split(/[-|_]/)[0].trim() : '') || sid;\n      let cover = '';\n      for (const k of ['coverSrc', 'posterSrc', 'cover_src', 'poster', 'cover']) {\n        const m = h.match(new RegExp(`\"${k}\"\\\\s*:\\\\s*\"([^\"]+)\"`));\n        if (m && m[1].indexOf('eisees.com') < 0) { cover = absUrl(pageUrl, m[1]); break; }\n      }\n      if (!cover) {\n        const cm = h.match(/https:\\/\\/pic\\.drleao\\.cn\\/[^\"'\\s<>]+/i);\n        if (cm) cover = unescapeHtml(cm[0]);\n      }\n      const descEl = doc.selectFirst('meta[name=\"description\"]');\n      const eps = [], seen = {};\n      for (const a of doc.select('a[href*=\"/video/' + sid + '\"]')) {\n        const href = absUrl(pageUrl, a.attr('href'));\n        const em = href.match(/\\/ep-(\\d+)/);\n        const epNum = Number(a.attr('data-ep-id')) || (em ? parseInt(em[1], 10) : epIndex(a.text(), 0));\n        if (!epNum || seen[epNum]) continue;\n        seen[epNum] = 1;\n        eps.push({ ep: epNum, id: `ai:${sid}:${epNum}`, name: `第${epNum}集` });\n      }\n      eps.sort((a, b) => a.ep - b.ep);\n      if (!eps.length) eps.push({ id: `ai:${sid}:1`, name: '第1集' });\n      return {\n        title,\n        cover,\n        desc: descEl ? descEl.attr('content') : '',\n        lines: [{ name: '黄果 AI', episodes: eps.map(e => ({ id: e.id, name: e.name })) }]\n      };\n    }\n    if (sub === 'video') {\n      const path = (sid.startsWith('series/') || sid.startsWith('video/')) ? sid : ('series/' + sid);\n      const pageUrl = `${VIDEO_BASE}/${path}`;\n      const r = await httpGet(pageUrl, VIDEO_BASE + '/');\n      const doc = host.html.parse(r.body, pageUrl);\n      const titleEl = doc.selectFirst('title');\n      const ogImg = doc.selectFirst('meta[property=\"og:image\"]');\n      const descEl = doc.selectFirst('meta[name=\"description\"]');\n      const eps = [], seen = {};\n      if (!path.startsWith('video/')) {\n        for (const a of doc.select('a[href*=\"/video/\"]')) {\n          const m = a.attr('href').match(/\\/video\\/([^/?#]+)/);\n          if (!m || seen[m[1]]) continue;\n          seen[m[1]] = 1;\n          const t = (a.attr('title') || a.text() || '').trim() || ('第' + (eps.length + 1) + '集');\n          eps.push({ id: 'video:' + m[1], name: t });\n        }\n      }\n      if (!eps.length) eps.push({ id: 'video:' + sid.replace(/^video\\//, ''), name: '第1集' });\n      return {\n        title: titleEl ? titleEl.text().split(/[-|_]/)[0].trim() : sid,\n        cover: ogImg ? absUrl(pageUrl, ogImg.attr('content')) : '',\n        desc: descEl ? descEl.attr('content') : '',\n        lines: [{ name: '黄果视频站', episodes: eps }]\n      };\n    }\n    throw host.error('E_NOT_FOUND', '不支持的黄果条目：' + id);\n  },\n\n  async play({ episodeId, id }) {\n    const parts = String(episodeId || id).split(':');\n    const sub = parts[0];\n    if (sub === 'ai') {\n      const sid = parts[1], ep = parseInt(parts[2] || '1', 10) || 1;\n      const base = await ensureAIBase();\n      const referer = `${base}/video/${sid}/`;\n      const headers = { 'User-Agent': UA, 'Origin': base, 'Referer': referer };\n      try {\n        const res = await host.http.request({\n          url: `${base}/api/videos/${sid}/episodes/${ep}/playback`,\n          method: 'POST',\n          body: '{}',\n          bodyType: 'text',\n          headers: Object.assign({ 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, headers),\n          timeout: 15000\n        });\n        if (res.status >= 200 && res.status < 300) {\n          const env = JSON.parse(res.body);\n          const data = env && env.data;\n          const main = data && data.streams && data.streams.main;\n          if (main && main.startsWith('https://')) {\n            const playHeaders = Object.assign({}, headers);\n            const cdn = data.cdn || {};\n            if ((cdn.m3u8Enabled || cdn.otherEnabled) && cdn.authValue && cdn.app) {\n              playHeaders['x-cdn-auth'] = cdn.authValue;\n              playHeaders['x-cdn-app'] = cdn.app;\n            }\n            const streams = [{ name: '主线', url: main, format: main.indexOf('.m3u8') >= 0 ? 'hls' : 'mp4', headers: playHeaders }];\n            if (data.streams.hevc && data.streams.hevc.startsWith('https://')) {\n              streams.push({ name: 'HEVC', url: data.streams.hevc, format: data.streams.hevc.indexOf('.m3u8') >= 0 ? 'hls' : 'mp4', headers: playHeaders });\n            }\n            return { streams };\n          }\n        }\n      } catch (_) {}\n      const pageUrl = ep > 1 ? `${base}/video/${sid}/ep-${ep}/` : `${base}/video/${sid}/`;\n      const r = await httpGet(pageUrl, base + '/');\n      const m = r.body.match(/[\"']?(?:videoSrc|videoUrl|playUrl)[\"']?\\s*[:=]\\s*[\"']([^\"']+\\.(?:m3u8|mp4)[^\"']*)[\"']/i)\n        || r.body.match(/data-play-src=[\"']([^\"']+)[\"']/i);\n      if (!m) throw host.error('E_PARSE', '未解析到黄果 AI 播放地址');\n      const u = absUrl(pageUrl, m[1]);\n      return { streams: [{ name: '默认', url: u, format: u.indexOf('.m3u8') >= 0 ? 'hls' : 'mp4', headers }] };\n    }\n    if (sub === 'video') {\n      const vid = parts[1];\n      const pageUrl = `${VIDEO_BASE}/video/${vid}`;\n      const r = await httpGet(pageUrl, VIDEO_BASE + '/');\n      const m = r.body.match(/data-hls=[\"']([^\"']+)[\"']/i);\n      if (!m) throw host.error('E_PARSE', '未解析到黄果视频站播放地址');\n      const u = absUrl(pageUrl, m[1]);\n      return { streams: [{ name: 'HLS', url: u, format: 'hls', headers: { 'User-Agent': UA, 'Referer': VIDEO_BASE + '/' } }] };\n    }\n    throw host.error('E_UNSUPPORTED', '不支持的播放条目');\n  }\n};\n"
 }
}
