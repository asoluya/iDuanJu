{"manifest": {"schema": 1, "id": "com.idj.bundled.4kvm", "name": "4K影视", "version": "1.0.0", "author": {"name": "asoluya"}, "description": "4kvm.tv：电影、电视剧、动漫，最高 1080p 免费线路（4K 为站方 VIP 线路）", "type": "video", "adult": false, "language": ["zh"], "minAppVersion": "1.5", "entry": "main.js", "permissions": {"http": ["4kvm.tv", "*.4kvm.tv", "4kvm.staticimgjs.org", "image.tmdb.org", "gimg0.baidu.com", "oss.douyinbit.com", "myoss.douyinbit.top"], "media": ["oss.douyinbit.com", "myoss.douyinbit.top"], "cloudflare": false, "storage": false, "login": false}, "capabilities": ["home", "category", "search", "detail", "play"], "settings": [], "integrity": {"files": {"main.js": "sha256-SPr0UztHx1CSVp2nbPuZl4RjXzmUUpthaZ5RWOqjjGw="}}}, "files": {"main.js": "// 4K影视 (4kvm.tv) — plugin for muju/iDuanJu\n// The site renders lists/detail as plain HTML. Playback goes through\n// /video/play?p=<dataid>&v=<slug>&q=1&s=<sig>&t=<ms>&k=<token> where\n//   sig   = HMAC-SHA256(key = slug, msg = \"<dataid>:<t>:<slug>\") hex, first 32 chars\n//   token = base64url(userlink XOR repeating \"nbmovie2024secretkey\")\n// and userlink is a per-page guest token embedded in every page's navbar.\n// (Protocol reverse-engineered from the site's own WASM signer, 2026-11-27.)\n\nconst SITE = 'https://4kvm.tv';\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1';\nconst XOR_KEY = 'nbmovie2024secretkey';\n\nconst CATEGORIES = [\n  { id: 'latest', name: '最新' },\n  { id: 'movie', name: '电影' },\n  { id: 'tv', name: '电视剧' },\n  { id: 'anime', name: '动漫' },\n];\nconst CAT_PATH = { latest: '/', movie: '/movie', tv: '/tv', anime: '/anime' };\n\n// ---------- pure JS SHA-256 (ASCII input) + HMAC ----------\nconst SHA256_K = [\n  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n];\nfunction sha256Bytes(ascii) {\n  function rr(v, a) { return (v >>> a) | (v << (32 - a)); }\n  const H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];\n  const bytes = [];\n  for (let i = 0; i < ascii.length; i++) bytes.push(ascii.charCodeAt(i) & 0xff);\n  const bitLen = bytes.length * 8;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  bytes.push(0, 0, 0, 0);\n  bytes.push((bitLen >>> 24) & 0xff, (bitLen >>> 16) & 0xff, (bitLen >>> 8) & 0xff, bitLen & 0xff);\n  const w = new Array(64);\n  for (let blk = 0; blk < bytes.length; blk += 64) {\n    for (let i = 0; i < 16; i++) {\n      w[i] = (bytes[blk + i * 4] << 24) | (bytes[blk + i * 4 + 1] << 16) | (bytes[blk + i * 4 + 2] << 8) | bytes[blk + i * 4 + 3];\n    }\n    for (let i = 16; i < 64; i++) {\n      const s0 = rr(w[i - 15], 7) ^ rr(w[i - 15], 18) ^ (w[i - 15] >>> 3);\n      const s1 = rr(w[i - 2], 17) ^ rr(w[i - 2], 19) ^ (w[i - 2] >>> 10);\n      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;\n    }\n    let [a, b, c, d, e, f, g, h] = H;\n    for (let i = 0; i < 64; i++) {\n      const S1 = rr(e, 6) ^ rr(e, 11) ^ rr(e, 25);\n      const ch = (e & f) ^ (~e & g);\n      const t1 = (h + S1 + ch + SHA256_K[i] + w[i]) | 0;\n      const S0 = rr(a, 2) ^ rr(a, 13) ^ rr(a, 22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const t2 = (S0 + maj) | 0;\n      h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;\n    }\n    H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;\n    H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;\n  }\n  const out = [];\n  for (const v of H) out.push((v >>> 24) & 0xff, (v >>> 16) & 0xff, (v >>> 8) & 0xff, v & 0xff);\n  return out;\n}\nfunction bytesToHex(bs) { return bs.map((b) => b.toString(16).padStart(2, '0')).join(''); }\nfunction bytesToAscii(bs) { return String.fromCharCode.apply(null, bs); }\nfunction hmacSha256Hex(keyAscii, msgAscii) {\n  let key = [];\n  for (let i = 0; i < keyAscii.length; i++) key.push(keyAscii.charCodeAt(i) & 0xff);\n  if (key.length > 64) key = sha256Bytes(keyAscii);\n  while (key.length < 64) key.push(0);\n  const ipad = key.map((b) => b ^ 0x36);\n  const opad = key.map((b) => b ^ 0x5c);\n  const inner = sha256Bytes(bytesToAscii(ipad) + msgAscii);\n  return bytesToHex(sha256Bytes(bytesToAscii(opad) + bytesToAscii(inner)));\n}\nconst B64URL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';\nfunction b64urlEncodeBytes(bytes) {\n  let out = '';\n  for (let i = 0; i < bytes.length; i += 3) {\n    const b0 = bytes[i];\n    const b1 = i + 1 < bytes.length ? bytes[i + 1] : 0;\n    const b2 = i + 2 < bytes.length ? bytes[i + 2] : 0;\n    out += B64URL[b0 >> 2];\n    out += B64URL[((b0 & 3) << 4) | (b1 >> 4)];\n    out += i + 1 < bytes.length ? B64URL[((b1 & 15) << 2) | (b2 >> 6)] : '=';\n    out += i + 2 < bytes.length ? B64URL[b2 & 63] : '=';\n  }\n  return out;\n}\nfunction makeToken(userlink) {\n  const bytes = [];\n  for (let i = 0; i < userlink.length; i++) {\n    bytes.push((userlink.charCodeAt(i) ^ XOR_KEY.charCodeAt(i % XOR_KEY.length)) & 0xff);\n  }\n  return b64urlEncodeBytes(bytes);\n}\n\n// ---------- http ----------\nasync function getText(url, referer) {\n  const res = await host.http.request({\n    url,\n    headers: { 'User-Agent': UA, Referer: referer || SITE + '/' },\n    timeout: 30,\n  });\n  if (res.status < 200 || res.status >= 300) throw host.error('E_HTTP', 'HTTP ' + res.status + '：' + url);\n  return res.body;\n}\n\n// ---------- parsing helpers ----------\nfunction unwrapCover(u) {\n  if (!u) return '';\n  u = String(u).replace(/&amp;/g, '&');\n  const m = /[?&]src=([^&]+)/.exec(u);\n  if (m) {\n    let real = m[1];\n    try { real = decodeURIComponent(real); } catch (e) { /* keep raw */ }\n    if (!/^https?:\\/\\//.test(real)) real = 'https://' + real.replace(/^\\/+/, '');\n    return real;\n  }\n  if (u.startsWith('/')) return SITE + u;\n  return u;\n}\nfunction extractUserlink(html) {\n  const m = /userlink\\s*:\\s*'([^']+)'/.exec(html) || /userlink\\s*:\\s*\"([^\"]+)\"/.exec(html);\n  return m ? m[1] : '';\n}\nconst B64CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\nfunction b64DecodeAscii(b64) {\n  const clean = String(b64).replace(/=+$/, '');\n  let out = '';\n  let acc = 0, bits = 0;\n  for (const ch of clean) {\n    const v = B64CHARS.indexOf(ch);\n    if (v < 0) continue;\n    acc = (acc << 6) | v; bits += 6;\n    if (bits >= 8) { bits -= 8; out += String.fromCharCode((acc >> bits) & 0xff); }\n  }\n  return out;\n}\nfunction extractBackupHosts(html) {\n  const m = /window\\._pdf\\s*=\\s*\"([^\"]+)\"/.exec(html);\n  if (!m) return [];\n  try {\n    const arr = JSON.parse(b64DecodeAscii(m[1]));\n    return Array.isArray(arr) ? arr.filter((x) => typeof x === 'string' && x) : [];\n  } catch (e) { return []; }\n}\nfunction parseCards(html, baseUrl) {\n  const doc = host.html.parse(html, baseUrl);\n  const anchors = doc.select('a[href^=\"/play/\"]');\n  const seen = new Set();\n  const items = [];\n  for (const a of anchors) {\n    const href = a.attr('href') || '';\n    const m = /^\\/play\\/([a-zA-Z0-9]+)$/.exec(href);\n    if (!m || seen.has(m[1])) continue;\n    const img = a.selectFirst('img');\n    if (!img) continue;\n    const cover = unwrapCover(img.attr('data-src') || img.attr('src') || '');\n    if (!cover || cover.includes('placeholder')) continue;\n    const title = (img.attr('alt') || '').trim();\n    if (!title) continue;\n    seen.add(m[1]);\n    let remarks = '';\n    const spans = a.select('span');\n    const bits = [];\n    for (const sp of spans) {\n      const t = (sp.text() || '').trim();\n      if (t && t.length <= 12) bits.push(t);\n    }\n    remarks = bits.slice(0, 2).join(' · ');\n    items.push({ id: m[1], title, cover, remarks, tags: [] });\n  }\n  return items;\n}\nfunction parseEpisodes(html) {\n  const re = /<a href=\"\\/play\\/([a-zA-Z0-9]+)\"[^>]*?data-line=\"(\\d+)\"\\s+data-episode=\"(\\d+)\"\\s+dataid=\"(\\d+)\"/g;\n  const byLine = new Map();\n  let total = 0;\n  let m;\n  while ((m = re.exec(html)) !== null) {\n    const slug = m[1], line = m[2], ep = m[3], dataid = m[4];\n    if (!byLine.has(line)) byLine.set(line, []);\n    byLine.get(line).push({ id: dataid + ':' + slug, name: '第' + ep + '集' });\n    total++;\n  }\n  const lines = [];\n  for (const [line, episodes] of byLine) {\n    lines.push({ name: '线路' + line, episodes });\n  }\n  if (total === 1 && lines.length === 1) lines[0].episodes[0].name = '正片';\n  return lines;\n}\n\n// ---------- plugin ----------\nexport default {\n  async home() {\n    const html = await getText(SITE + '/');\n    const items = parseCards(html, SITE + '/');\n    return { categories: CATEGORIES, items, hasMore: true };\n  },\n\n  async category({ id, page }) {\n    const path = CAT_PATH[id] || '/';\n    const current = page && page > 0 ? page : 1;\n    const url = SITE + path + (current > 1 ? '?page=' + current : '');\n    const html = await getText(url);\n    const items = parseCards(html, url);\n    return { items, page: current, hasMore: items.length > 0 };\n  },\n\n  async search({ keyword, page }) {\n    const current = page && page > 0 ? page : 1;\n    const url = SITE + '/search?q=' + encodeURIComponent(keyword) + (current > 1 ? '&page=' + current : '');\n    const html = await getText(url);\n    const items = parseCards(html, url);\n    return { items, page: current, hasMore: items.length > 0 };\n  },\n\n  async detail({ id }) {\n    const url = SITE + '/play/' + id;\n    const html = await getText(url);\n    const doc = host.html.parse(html, url);\n    const h1 = doc.selectFirst('h1');\n    let title = h1 ? (h1.text() || '').trim() : '';\n    if (!title) {\n      const og = doc.selectFirst('meta[property=\"og:title\"]');\n      title = og ? (og.attr('content') || '').replace(/\\s*-\\s*第.*$/, '').trim() : id;\n    }\n    let cover = '';\n    const player = doc.selectFirst('.video-player');\n    if (player) cover = unwrapCover(player.attr('data-poster') || '');\n    if (!cover) {\n      const ogi = doc.selectFirst('meta[property=\"og:image\"]');\n      if (ogi) cover = unwrapCover(ogi.attr('content') || '');\n    }\n    let desc = '';\n    const ps = doc.select('p');\n    for (const p of ps) {\n      const t = (p.text() || '').trim();\n      if (t.length > 30) { desc = t; break; }\n    }\n    const lines = parseEpisodes(html);\n    if (!lines.length) throw host.error('E_PARSE', '没有解析到选集：' + url);\n    return { title, desc, tags: [], lines, cover };\n  },\n\n  async play({ episodeId }) {\n    const sep = String(episodeId).indexOf(':');\n    if (sep < 0) throw host.error('E_ID', '条目标识无效');\n    const dataid = String(episodeId).slice(0, sep);\n    const slug = String(episodeId).slice(sep + 1);\n    const pageUrl = SITE + '/play/' + slug;\n    const html = await getText(pageUrl);\n    const userlink = extractUserlink(html);\n    if (!userlink) throw host.error('E_TOKEN', '页面里没找到访问令牌');\n    const backups = extractBackupHosts(html);\n    const t = Date.now();\n    const s = hmacSha256Hex(slug, dataid + ':' + t + ':' + slug).slice(0, 32);\n    const k = makeToken(userlink);\n    const api = SITE + '/video/play?p=' + encodeURIComponent(dataid) + '&v=' + encodeURIComponent(slug) +\n      '&q=1&s=' + s + '&t=' + t + '&k=' + encodeURIComponent(k);\n    const body = await getText(api, pageUrl);\n    let data;\n    try { data = JSON.parse(body); } catch (e) { throw host.error('E_API', '播放接口返回异常：' + body.slice(0, 120)); }\n    if (!data || data.code !== 200 || !data.data) {\n      throw host.error('E_API', '播放接口失败：' + ((data && data.message) || body.slice(0, 120)));\n    }\n    const streams = [];\n    for (const q of data.data.quality_urls || []) {\n      if (!q || q.locked || !q.url || q.url === '1' || !/^https?:\\/\\//.test(q.url)) continue;\n      const name = ((q.description || '') + ' ' + (q.title || '')).trim() || '默认';\n      const format = q.mtype === 'm3u8' || q.url.includes('.m3u8') ? 'hls' : 'mp4';\n      streams.push({ name, url: q.url, format });\n      const hm = /^https?:\\/\\/([^/]+)/.exec(q.url);\n      if (hm) {\n        for (const b of backups) {\n          if (b && b !== hm[1]) {\n            streams.push({ name: name + '（备线）', url: q.url.replace(hm[1], b), format });\n          }\n        }\n      }\n    }\n    if (!streams.length) throw host.error('E_VIP', '该集暂无可播放的免费线路（4K 为 VIP 线路）');\n    return { streams };\n  },\n};\n"}}