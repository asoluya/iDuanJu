an).slice(0, 3));\r\n  return {\r\n    id,\r\n    title,\r\n    cover,\r\n    remarks: total > 0 ? `全${total}集` : String(v.score_text || ''),\r\n    tags,\r\n    orientation: 'portrait'\r\n  };\r\n}\r\n\r\nasync function signedGet(url, dev) {\r\n  const headers = Object.assign({\r\n    'User-Agent': UA, 'Accept': 'application/json; charset=utf-8',\r\n    'x-ss-dp': '8662', 'comment-source': '1506', 'lc': '101'\r\n  }, fullHeaders(url, dev));\r\n  const r = await host.http.request({ url, headers, timeout: 15000 });\r\n  if (r.status < 200 || r.status >= 300) throw host.error('E_HTTP', 'HTTP ' + r.status);\r\n  return JSON.parse(r.body);\r\n}\r\n\r\nfunction decodeMediaUrl(v) {\r\n  if (!v || typeof v !== 'string') return '';\r\n  if (/^https?:\\/\\//i.test(v)) return v.replace(/^http:\\/\\//i, 'https://');\r\n  try {\r\n    const s = host.codec.base64Decode(v);\r\n    if (/^https?:\\/\\//i.test(s)) return s.replace(/^http:\\/\\//i, 'https://');\r\n  } catch (_) {}\r\n  return '';\r\n}\r\n\r\nfunction parseVideoModel(vm) {\r\n  let entries = [];\r\n  if (vm && vm.video_list) entries = Array.isArray(vm.video_list) ? vm.video_list : Object.values(vm.video_list);\r\n  const streams = [];\r\n  for (const v of entries) {\r\n    if (!v || typeof v !== 'object') continue;\r\n    const meta = v.video_meta || {}, enc = v.encrypt_info || {};\r\n    const codec = String(meta.codec_type || v.codec_type || '').toLowerCase();\r\n    if (codec === 'bytevc2' || String(v.gear_des_key || '').toLowerCase().indexOf('bytevc2') >= 0) continue;\r\n    const url = decodeMediaUrl(v.main_url) || decodeMediaUrl(v.backup_url);\r\n    if (!url) continue;\r\n    const spade = String(enc.spade_a || v.spade_a || '');\r\n    let key = '';\r\n    if (spade || enc.encrypt || enc.encryption_method === 'cenc-aes-ctr') {\r\n      key = contentKey(spade);\r\n      if (!key) continue;\r\n    }\r\n    const def = String(meta.definition || v.definition || '720p');\r\n    const h = parseInt(def.replace(/[^0-9]/g, ''), 10) || 0;\r\n    streams.push({ name: `${def}${codec ? ' ' + codec : ''}`, url, format: key ? 'cenc' : 'mp4', key, _h: h, _h264: codec === 'h264' || codec === 'avc1' ? 1 : 0 });\r\n  }\r\n  streams.sort((a, b) => (b._h - a._h) || (b._h264 - a._h264));\r\n  return streams.map(({ name, url, format, key }) => (key ? { name, url, format, key } : { name, url, format }));\r\n}\r\n\r\nexport default {\r\n  async home() {\r\n    const p = await this.category({ id: CATEGORIES[0].id, page: 1 });\r\n    return { categories: CATEGORIES, items: p.items, hasMore: p.hasMore };\r\n  },\r\n\r\n  async category({ id = CATEGORIES[0].id, page = 1 }) {\r\n    const d = await ensureDevice();\r\n    const [genre, subId] = String(id).split(':');\r\n    const offset = (Math.max(1, Number(page) || 1) - 1) * 20;\r\n    const u = `https://api5-normal-sinfonlinec.fqnovel.com/reading/bookapi/bookmall/cell/change/v:version/?background_selected_items&celebrity_user_id&cell_id=7470092475068071998&client_req_type=2&client_template=2&filter_ids=&offset=${offset}&panel_selected_items&rank_version=${Math.floor(Date.now() / 1000)}&screen_width_px=1080&selected_items=${encodeURIComponent(genre || 'all')}&sub_selected_items=${encodeURIComponent(subId || 'ranklist_hot_sc')}&tab_type=26&unlimited_selector_change_type=1&${listQuery(d)}`;\r\n    const j = await signedGet(u, d);\r\n    if (String(j.code) !== '0') throw host.error('E_HTTP', `红果榜单 code=${j.code} ${j.message || ''}`);\r\n    const items = [], seen = {};\r\n    const cells = (j.data && j.data.cell_view && j.data.cell_view.cell_data) || [];\r\n    for (const c of cells) {\r\n      for (const v of (c && c.video_data) || []) {\r\n        const s = parseSeries(v);\r\n        if (s && !seen[s.id]) { seen[s.id] = 1; items.push(s); }\r\n      }\r\n    }\r\n    return { items, hasMore: Boolean(j.data && j.data.has_more) && items.length > 0 };\r\n  },\r\n\r\n  async search({ keyword, page = 1 }) {\r\n    const d = await ensureDevice();\r\n    const offset = (Math.max(1, Number(page) || 1) - 1) * 10;\r\n    const q = encodeURIComponent(String(keyword || '').trim());\r\n    const sid = encodeURIComponent(d.cdid || '0');\r\n    const u = `https://api5-normal-sinfonlinec.fqnovel.com/reading/bookapi/search/tab/v?bookshelf_search_plan=4&live_room_id=0&user_is_login=0&bookstore_tab=-1&biz_config_ctx_infos&last_book_id=0&last_search_page_query=${q}&clicked_content=page_search_button&report_info&use_lynx=false&last_book_consume_time=0&product_id=0&line_words_num=0&tab_name&last_consume_interval=0&pad_column_cover=0&last_chapter_id=0&only_feed=false&offset=${offset}&from_rs=false&only_large_card=false&query=${q}&count=0&search_source=0&search_source_id=clks%23%23%23&use_correct=false&last_search_page_interval=0&seed_product_id=0&from_half_screen=false&is_first_enter_search=${offset === 0}&iid=${d.iid}&device_id=${d.deviceId}&ac=wifi&channel=vivo_8662_64&aid=8662&app_name=novelread&version_code=73532&version_name=7.3.5.32&device_platform=android&os=android&ssmix=a&device_type=NX809J&device_brand=Nubia&language=zh&os_api=31&os_version=12&manifest_version_code=73532&resolution=1280*720&dpi=240&update_version_code=73532&_rticket=${Date.now()}&normal_session_cnt_in_day=1&gender=2&cold_start_session_cnt_in_day=1&host_abi=arm64-v8a&dragon_device_type=pad&sys_mini_window=0&pv_player=73532&app_mini_window=0&normal_session_id=${sid}%231&compliance_status=0&har_status=1&cold_start_session_id=${sid}&cold_start_session_cnt_in_life=1&charging=0&normal_session_cnt_in_life=1&is_power_save_mode=0&app_dark_mode=0&screen_brightness=102&battery_pct=80&down_speed=30000&sys_dark_mode=0&need_personal_recommend=1&player_so_load=1&font_scale=100&is_android_pad_screen=1&network_type=4&rom_version=Nubia-user+12.0.0+20171130.276299+release-keys&current_volume=33&cdid=${d.cdid}&client_ab_info=%7B%22middle_style_from_video%22%3Afalse%2C%22result_style_from_video%22%3Afalse%7D`;\r\n    const j = await signedGet(u, d);\r\n    if (String(j.code) !== '0') throw host.error('E_HTTP', `红果搜索 code=${j.code}`);\r\n    const items = [], seen = {};\r\n    let hasMore = false;\r\n    for (const tab of (j.search_tabs || [])) {\r\n      if (tab.tab_type !== 11 && tab.title !== '综合') continue;\r\n      hasMore = Boolean(tab.has_more);\r\n      for (const c of (tab.data || [])) {\r\n        const vds = Array.isArray(c.video_data) ? c.video_data : (c.video_data ? [c.video_data] : []);\r\n        for (const v of vds) {\r\n          const s = parseSeries(v);\r\n          if (s && !seen[s.id]) { seen[s.id] = 1; items.push(s); }\r\n        }\r\n      }\r\n      break;\r\n    }\r\n    return { items, hasMore: hasMore && items.length > 0 };\r\n  },\r\n\r\n  async detail({ id }) {\r\n    const d = await ensureDevice();\r\n    const u = `https://api5-normal-sinfonlinea.fqnovel.com/reading/bookapi/directory/all_items/v?book_id=${encodeURIComponent(id)}&need_version=true&${listQuery(d)}`;\r\n    const j = await signedGet(u, d);\r\n    const data = j.data || {};\r\n    const info = data.book_info || {};\r\n    const list = Array.isArray(data.item_data_list) ? data.item_data_list : [];\r\n    const episodes = [];\r\n    for (let i = 0; i < list.length; i++) {\r\n      const m = list[i] || {};\r\n      const vid = String(m.item_id || m.vid || '').trim();\r\n      if (!vid) continue;\r\n      episodes.push({ id: vid, name: String(m.title || `第${i + 1}集`) });\r\n    }\r\n    return {\r\n      title: String(info.book_name || info.original_book_name || id),\r\n      cover: String(info.thumb_url || '').replace(/^http:\\/\\//i, 'https://'),\r\n      desc: String(info.abstract || ''),\r\n      director: String(info.author || ''),\r\n      lines: [{ name: '红果短剧', episodes }]\r\n    };\r\n  },\r\n\r\n  async play({ episodeId }) {\r\n    const vid = String(episodeId || '').trim();\r\n    const pairs = V5_APP_QUERY.concat([\r\n      ['iid', FALLBACK_V5_ID.iid], ['cdid', FALLBACK_V5_ID.cdid], ['device_id', FALLBACK_V5_ID.deviceId],\r\n      ['video_id', vid], ['video_id_type', '0'], ['device_level', '1'],\r\n      ['need_all_video_definition', '1'], ['need_mp4_align', '0'], ['use_os_player', '0'],\r\n      ['video_platform', '1024'], ['source', '0'], ['from_video_id', '']\r\n    ]);\r\n    for (const h of ['api5-normal-sinfonlineb.fqnovel.com', 'api5-normal-hl.fqnovel.com']) {\r\n      try {\r\n        const signed = signPlaybackV5(pairs);\r\n        const r = await host.http.request({\r\n          url: `https://${h}/reading/bookapi/video_tab/multi_video_model/v1/?${signed.query}`,\r\n          headers: Object.assign({ 'User-Agent': VIDEO_TAB_UA, 'Accept': 'application/json; charset=utf-8', 'Accept-Language': 'zh-CN,zh;q=0.9' }, signed.headers),\r\n          timeout: 15000\r\n        });\r\n        if (r.status === 200 && r.body) {\r\n          const j = JSON.parse(r.body);\r\n          const data = j.data || {};\r\n          const bucket = data.video_model_data || data['1004'] || data;\r\n          const entry = bucket[vid] || {};\r\n          const vm = typeof entry.video_model === 'string' ? JSON.parse(entry.video_model) : entry.video_model;\r\n          const streams = parseVideoModel(vm);\r\n          if (streams.length) return { streams };\r\n        }\r\n      } catch (_) {}\r\n    }\r\n    // Web fallback API\r\n    const wr = await host.http.request({\r\n      url: 'https://hongguoduanju.com/api/video/protected/fallback-play-info',\r\n      method: 'POST',\r\n      body: JSON.stringify({ force_refresh: false, item_id: vid }),\r\n      bodyType: 'text',\r\n      headers: {\r\n        'User-Agent': WEB_UA, 'Content-Type': 'application/json; charset=utf-8',\r\n        'Accept': 'application/json', 'Origin': 'https://hongguoduanju.com', 'Referer': 'https://hongguoduanju.com/'\r\n      },\r\n      timeout: 10000\r\n    });\r\n    if (wr.status === 200 && wr.body) {\r\n      const j = JSON.parse(wr.body);\r\n      const d = (j.data && Object.keys(j.data).length) ? j.data : j;\r\n      const u = String(d.play_url || d.main_url || d.url || '').replace(/^http:\\/\\//i, 'https://');\r\n      if (u.startsWith('https://')) {\r\n        return { streams: [{ name: String(d.definition || '360p'), url: u, format: 'mp4' }] };\r\n      }\r\n    }\r\n    throw host.error('E_HTTP', '红果取流失败，请稍后重试');\r\n  }\r\n};\r\n"
 }
