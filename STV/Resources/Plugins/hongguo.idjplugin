 "files": {
  "main.js": "// 红果短剧 · i短剧 idj1 短剧插件（独立设备注册 + Medusa/V5 签名 + spade_a 密钥解包）\r\nconst MEDUSA_TABLES_B64 = \"\";\r\nconst V5_PROFILE_B64 = \"\";\r\n\r\nconst UA = 'com.phoenix.read/72133 (Linux; U; Android 10; zh_CN_#Hans; EML-AL00; Build/HUAWEIEML-AL00; Cronet/TTNetVersion:04657795 2026-01-23 QuicVersion:c67e9834 2025-09-08)';\r\nconst VIDEO_TAB_UA = 'com.phoenix.read/73932 (Linux; U; Android 16; zh_CN; 25053RT47C; Build/BP2A.250605.031.A3; Cronet/TTNetVersion:04657795 2026-01-23 QuicVersion:c67e9834 2025-09-08)';\r\nconst WEB_UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 Version/17.0 Mobile/15E148 Safari/604.1';\r\n\r\nconst FALLBACK_V5_ID = {\r\n  deviceId: '1624456208323876',\r\n  iid: '1624456208327972',\r\n  cdid: '91d56f7e-c027-4ce9-9a3c-229d59a13c3b',\r\n  openudid: '56a962410c494bba'\r\n};\r\n\r\nconst V5_APP_QUERY = [\r\n  ['aid', '8662'], ['app_name', 'novelread'], ['version_code', '74532'], ['version_name', '7.4.5.32'],\r\n  ['update_version_code', '74532'], ['manifest_version_code', '74532'], ['os', 'android'], ['ssmix', 'a'],\r\n  ['channel', 'update_64'], ['device_platform', 'android'], ['device_type', '25053RT47C'], ['device_brand', 'Redmi'],\r\n  ['os_version', '16'], ['os_api', '36'], ['ac', 'wifi'], ['language', 'zh'], ['host_abi', 'arm64-v8a']\r\n];\r\n\r\nconst CATEGORIES = [\r\n  { id: 'all:ranklist_hot_sc', name: '推荐榜', isRank: true },\r\n  { id: 'all:ranklist_hot_play_sc', name: '热播榜', isRank: true },\r\n  { id: 'all:ranklist_new_rank_sc', name: '新剧榜', isRank: true },\r\n  { id: 'all:ranklist_hot_search_sc', name: '热搜榜', isRank: true },\r\n  { id: 'human:human_hot_sc', name: '真人热播', isRank: true },\r\n  { id: 'human:human_new_rank', name: '真人新剧', isRank: true },\r\n  { id: 'comic_series_rank:comic_series_hot_rank', name: '漫剧推荐', isRank: true },\r\n  { id: 'ai_playlet:ai_playlet_hot_sc', name: 'AI短剧', isRank: true }\r\n];\r\n\r\n// ---- Byte helpers ----\r\nfunction utf8Bytes(str) {\r\n  const out = [];\r\n  for (let i = 0; i < str.length; i++) {\r\n    let c = str.charCodeAt(i);\r\n    if (c < 0x80) out.push(c);\r\n    else if (c < 0x800) { out.push(0xc0 | (c >> 6), 0x80 | (c & 0x3f)); }\r\n    else if ((c & 0xfc00) === 0xd800 && i + 1 < str.length) {\r\n      const c2 = str.charCodeAt(++i);\r\n      const cp = 0x10000 + (((c & 0x3ff) << 10) | (c2 & 0x3ff));\r\n      out.push(0xf0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3f), 0x80 | ((cp >> 6) & 0x3f), 0x80 | (cp & 0x3f));\r\n    } else {\r\n      out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 0x3f), 0x80 | (c & 0x3f));\r\n    }\r\n  }\r\n  return out;\r\n}\r\nfunction bytesToUtf8(arr) {\r\n  let s = '', i = 0;\r\n  while (i < arr.length) {\r\n    const c = arr[i++];\r\n    if (c < 0x80) s += String.fromCharCode(c);\r\n    else if ((c & 0xe0) === 0xc0) s += String.fromCharCode(((c & 0x1f) << 6) | (arr[i++] & 0x3f));\r\n    else if ((c & 0xf0) === 0xe0) s += String.fromCharCode(((c & 0x0f) << 12) | ((arr[i++] & 0x3f) << 6) | (arr[i++] & 0x3f));\r\n    else {\r\n      const cp = ((c & 7) << 18) | ((arr[i++] & 0x3f) << 12) | ((arr[i++] & 0x3f) << 6) | (arr[i++] & 0x3f) - 0x10000;\r\n      s += String.fromCharCode(0xd800 | (cp >> 10), 0xdc00 | (cp & 0x3ff));\r\n    }\r\n  }\r\n  return s;\r\n}\r\nfunction hexToBytes(h) {\r\n  const out = [];\r\n  for (let i = 0; i + 1 < h.length; i += 2) out.push(parseInt(h.slice(i, i + 2), 16));\r\n  return out;\r\n}\r\nfunction bytesToHex(b) {\r\n  let s = '';\r\n  for (let i = 0; i < b.length; i++) s += (b[i] & 255).toString(16).padStart(2, '0');\r\n  return s;\r\n}\r\nfunction b64ToBytes(s) {\r\n  return hexToBytes(host.codec.convert(s, 'base64', 'hex'));\r\n}\r\nfunction bytesToB64(b) {\r\n  return host.codec.convert(bytesToHex(b), 'hex', 'base64');\r\n}\r\nfunction md5Bytes(b) {\r\n  return hexToBytes(host.crypto.md5(bytesToHex(b), { in: 'hex', out: 'hex' }));\r\n}\r\nfunction randBytes(n) {\r\n  return hexToBytes(host.crypto.randomHex(n));\r\n}\r\nfunction u32LE(v) { v = v >>> 0; return [v & 255, (v >>> 8) & 255, (v >>> 16) & 255, (v >>> 24) & 255]; }\r\nfunction u32BE(v) { v = v >>> 0; return [(v >>> 24) & 255, (v >>> 16) & 255, (v >>> 8) & 255, v & 255]; }\r\nfunction rdLE32(b, o) { return ((b[o]) | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)) >>> 0; }\r\nfunction rdBE32(b, o) { return ((b[o] << 24) | (b[o + 1] << 16) | (b[o + 2] << 8) | b[o + 3]) >>> 0; }\r\nfunction rdLE64(b, o) { return BigInt(rdLE32(b, o)) | (BigInt(rdLE32(b, o + 4)) << 32n); }\r\nfunction wrLE64(v) { const lo = Number(v & 0xffffffffn), hi = Number((v >> 32n) & 0xffffffffn); return u32LE(lo).concat(u32LE(hi)); }\r\nfunction rol32(x, n) { n &= 31; return n === 0 ? (x >>> 0) : (((x << n) | (x >>> (32 - n))) >>> 0); }\r\nfunction ror32(x, n) { n &= 31; return n === 0 ? (x >>> 0) : (((x >>> n) | (x << (32 - n))) >>> 0); }\r\nfunction ror64(v, c) { c = BigInt(c & 63); return c === 0n ? (v & 0xffffffffffffffffn) : (((v >> c) | (v << (64n - c))) & 0xffffffffffffffffn); }\r\nfunction popcount32(x) { x = x - ((x >>> 1) & 0x55555555); x = (x & 0x33333333) + ((x >>> 2) & 0x33333333); return (((x + (x >>> 4)) & 0x0f0f0f0f) * 0x01010101) >>> 24; }\r\nfunction popcount64(v) { return popcount32(Number(v & 0xffffffffn)) + popcount32(Number((v >> 32n) & 0xffffffffn)); }\r\n\r\n// ---- SM3 ----\r\nconst SM3_IV = [0x7380166F, 0x4914B2B9, 0x172442D7, 0xDA8A0600, 0xA96F30BC, 0x163138AA, 0xE38DEE4D, 0xB0FB0E4E];\r\nfunction sm3(data) {\r\n  const v = SM3_IV.slice();\r\n  const buf = data.slice();\r\n  buf.push(0x80);\r\n  while (buf.length % 64 !== 56) buf.push(0);\r\n  const bitLen = BigInt(data.length) * 8n;\r\n  for (let i = 7; i >= 0; i--) buf.push(Number((bitLen >> BigInt(i * 8)) & 0xffn));\r\n  const w = new Uint32Array(68), w1 = new Uint32Array(64);\r\n  for (let off = 0; off < buf.length; off += 64) {\r\n    for (let i = 0; i < 16; i++) w[i] = rdBE32(buf, off + i * 4);\r\n    for (let j = 16; j < 68; j++) {\r\n      const x = (w[j - 16] ^ w[j - 9] ^ rol32(w[j - 3], 15)) >>> 0;\r\n      const p1 = (x ^ rol32(x, 15) ^ rol32(x, 23)) >>> 0;\r\n      w[j] = (p1 ^ rol32(w[j - 13], 7) ^ w[j - 6]) >>> 0;\r\n    }\r\n    for (let j = 0; j < 64; j++) w1[j] = (w[j] ^ w[j + 4]) >>> 0;\r\n    let [a, b, c, d, e, f, g, h] = v;\r\n    for (let j = 0; j < 64; j++) {\r\n      const tj = j < 16 ? 0x79CC4519 : 0x7A879D8A;\r\n      const ss1 = rol32((rol32(a, 12) + e + rol32(tj, j)) >>> 0, 7);\r\n      const ss2 = (ss1 ^ rol32(a, 12)) >>> 0;\r\n      const ff = j < 16 ? ((a ^ b ^ c) >>> 0) : (((a & b) | (a & c) | (b & c)) >>> 0);\r\n      const gg = j < 16 ? ((e ^ f ^ g) >>> 0) : (((e & f) | ((~e) & g)) >>> 0);\r\n      const tt1 = (ff + d + ss2 + w1[j]) >>> 0;\r\n      const tt2 = (gg + h + ss1 + w[j]) >>> 0;\r\n      d = c; c = rol32(b, 9); b = a; a = tt1;\r\n      h = g; g = rol32(f, 19); f = e; e = (tt2 ^ rol32(tt2, 9) ^ rol32(tt2, 17)) >>> 0;\r\n    }\r\n    v[0] = (v[0] ^ a) >>> 0; v[1] = (v[1] ^ b) >>> 0; v[2] = (v[2] ^ c) >>> 0; v[3] = (v[3] ^ d) >>> 0;\r\n    v[4] = (v[4] ^ e) >>> 0; v[5] = (v[5] ^ f) >>> 0; v[6] = (v[6] ^ g) >>> 0; v[7] = (v[7] ^ h) >>> 0;\r\n  }\r\n  const out = [];\r\n  for (let i = 0; i < 8; i++) out.push(...u32BE(v[i]));\r\n  return out;\r\n}\r\n\r\n// ---- X-Gorgon / X-Argus / X-Helios ----\r\nfunction bitReverse8(b) { let r = 0; for (let i = 0; i < 8; i++) if (b & (1 << i)) r |= 1 << (7 - i); return r; }\r\nfunction brokenRC4(key, n) {\r\n  const S = []; for (let i = 0; i < 256; i++) S[i] = i;\r\n  let j = 0;\r\n  for (let i = 0; i < 256; i++) { j = (j + S[i] + key[i & 7]) & 255; S[i] = S[j]; }\r\n  let i = 0, jj = 0; const out = [];\r\n  for (let k = 0; k < n; k++) {\r\n    i = (i + 1) & 255; jj = (jj + S[i]) & 255;\r\n    const v = S[jj]; S[i] = v;\r\n    out.push(S[(S[i] + v) & 255] & 255);\r\n  }\r\n  return out;\r\n}\r\nfunction xGorgon(params, ts, bodyBytes, flags = 0x4481) {\r\n  const variant = (((Math.floor(Math.random() * 16) << 12) | Math.floor(Math.random() * 256)) & 0xffff);\r\n  const chunkX = (bodyBytes && bodyBytes.length) ? md5Bytes(bodyBytes).slice(0, 4) : [0, 0, 0, 0];\r\n  const concat = md5Bytes(utf8Bytes(params)).slice(0, 4).concat(chunkX, [0, 0, 0, 0, 0, 3, 10, 4], u32BE(ts >>> 0));\r\n  const fh = (flags >> 8) & 255, fl = flags & 255;\r\n  const key = [0x4a, fh, 0x16, variant & 255, 0x47, 0x6c, fl, (variant >> 8) & 255];\r\n  const ks = brokenRC4(key, 20);\r\n  const buf = concat.map((v, i) => v ^ ks[i]);\r\n  for (let n = 0; n < 20; n++) {\r\n    buf[n] = ((buf[n] & 15) << 4) | ((buf[n] >> 4) & 15);\r\n    const x = buf[n] ^ buf[(n + 1) % 20];\r\n    buf[n] = (0x14 ^ (~bitReverse8(x))) & 255;\r\n  }\r\n  return bytesToHex([0x84, 0x04, (variant >> 8) & 255, variant & 255, fh, fl].concat(buf));\r\n}\r\nfunction xArgus(ts) { return bytesToB64(u32LE(ts >>> 0)); }\r\nfunction basicHeaders(params, bodyBytes) {\r\n  const ts = Math.floor(Date.now() / 1000);\r\n  return { 'X-Khronos': String(ts), 'X-Gorgon': xGorgon(params, ts, bodyBytes), 'X-Argus': xArgus(ts) };\r\n}\r\nfunction heliosToken(khronos, license = '1611921764', aid = '8662', r4) {\r\n  const r = r4 || randBytes(4);\r\n  const md5hex = utf8Bytes(bytesToHex(md5Bytes(r.concat(utf8Bytes(aid)))));\r\n  const keys = [rdLE64(md5hex, 0)];\r\n  let b0 = keys[0], b8 = rdLE64(md5hex, 8);\r\n  const queue = [rdLE64(md5hex, 16), rdLE64(md5hex, 24)];\r\n  for (let i = 0; i < 34; i++) {\r\n    let x8 = ((ror64(b8, 8) + b0) & 0xffffffffffffffffn) ^ BigInt(i);\r\n    queue.push(x8);\r\n    x8 = (x8 ^ ror64(b0, 61)) & 0xffffffffffffffffn;\r\n    keys.push(x8);\r\n    b0 = x8; b8 = queue.shift();\r\n  }\r\n  const raw = utf8Bytes(`${khronos}-${license}-${aid}`);\r\n  const pad = 16 - (raw.length % 16);\r\n  for (let i = 0; i < pad; i++) raw.push(pad);\r\n  const body = [];\r\n  for (let off = 0; off < raw.length; off += 16) {\r\n    let d0 = rdLE64(raw, off), d1 = rdLE64(raw, off + 8);\r\n    for (let i = 0; i < 34; i++) {\r\n      d1 = (keys[i] ^ ((d0 + ror64(d1, 8)) & 0xffffffffffffffffn)) & 0xffffffffffffffffn;\r\n      d0 =