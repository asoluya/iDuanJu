{
 "manifest": {
  "schema": 1,
  "id": "com.idj.bundled.51k",
  "name": "51K",
  "version": "1.0.1",
  "author": {
   "name": "asoluya"
  },
  "description": "51K 看片：经永久域名 51k.pro 自动分发最新线路（极速/备用/海外），精选、极品、日韩、国产等分类，HLS 直链播放",
  "type": "video",
  "adult": true,
  "language": [
   "zh"
  ],
  "minAppVersion": "1.5",
  "entry": "main.js",
  "permissions": {
   "http": [
    "51k.pro",
    "www.51006.xyz",
    "www.51005.xyz",
    "*.kp006.xyz",
    "*.by006.xyz",
    "*.51k.info",
    "1.51512.xyz",
    "*.xbp261111.top"
   ],
   "media": [
    "*.xbv2608.com",
    "*.xbp261111.top"
   ],
   "cloudflare": false,
   "storage": false,
   "login": false
  },
  "capabilities": [
   "home",
   "category",
   "search",
   "detail",
   "play"
  ],
  "settings": [],
  "integrity": {
   "files": {
    "main.js": "sha256-nhsedHcoclHyvAX2nbd10b9WSkuHy80EAE9GM2k66iw="
   }
  }
 },
 "files": {
  "main.js": "// 51K — MacCMS 站点插件（永久域名自动分发线路）\n// 域名结构: 永久域名 51k.pro 是落地页, /go?action=get_route 给出当前「发布页」\n// (如 www.51006.xyz); 发布页的 /go、/go2、/go3 (action=fetch_target) 再给出\n// 三条真实线路 (极速/备用/海外, 子域名随机轮换)。插件按同样的顺序问线路,\n// 并逐条试开页面 (发布页和落地页也是 HTTP 200, 必须验内容不是只看状态码),\n// 命中的线路会被记住。已知旧线路 1.51512.xyz 放在最后兜底。\n// 列表: .vod-item 卡片 (a[href^=\"/vodplay/\"], img[data-src], .rank-title, .pre-time)\n// 详情: /voddetail/<id>.html 的 #playlist_N 分线选集\n// 播放: /vodplay/<id>-<sid>-<nid>.html 里的 player_aaaa JSON (encrypt=0 直链 m3u8)\n\nconst ENTRY = 'https://51k.pro';\nconst KNOWN_HUBS = ['https://www.51006.xyz', 'https://www.51005.xyz'];\nconst FALLBACK_BASES = ['https://1.51512.xyz'];\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1';\nconst XHR_HEADERS = { 'User-Agent': UA, 'X-Requested-With': 'XMLHttpRequest' };\n\nlet candidatesPromise = null;\nlet goodBase = '';\n\nfunction headersFor(base) {\n  return { 'User-Agent': UA, 'Referer': base + '/' };\n}\n\nasync function routeJson(url) {\n  const r = await host.http.request({ url, headers: XHR_HEADERS, timeout: 15 });\n  if (r.status < 200 || r.status >= 300 || !r.body) return null;\n  try {\n    const data = JSON.parse(r.body);\n    const u = String((data && data.url) || '').replace(/\\/+$/, '');\n    return /^https?:\\/\\//.test(u) ? u : null;\n  } catch (e) {\n    return null;\n  }\n}\n\n// 问出候选线路列表: 发布页分发的三条线路在前, 已知旧线路兜底。\nasync function resolveCandidates() {\n  const lines = [];\n  let hubs = KNOWN_HUBS.slice();\n  const hub = await routeJson(ENTRY + '/go?action=get_route').catch(() => null);\n  if (hub && !hubs.includes(hub)) hubs = [hub].concat(hubs);\n  for (const h of hubs) {\n    let got = false;\n    const paths = ['/go?action=fetch_target', '/go2?action=fetch_target', '/go3?action=fetch_target'];\n    for (const p of paths) {\n      const u = await routeJson(h + p).catch(() => null);\n      if (u && !lines.includes(u)) { lines.push(u); got = true; }\n    }\n    if (got) break;\n  }\n  return lines.concat(FALLBACK_BASES);\n}\n\nfunction getCandidates() {\n  if (!candidatesPromise) candidatesPromise = resolveCandidates();\n  return candidatesPromise;\n}\n\nconst CATEGORIES = [\n  { id: '1', name: '精选' },\n  { id: '2', name: '极品' },\n  { id: '3', name: '日韩' },\n  { id: '4', name: '特供' },\n  { id: '6', name: '主播直播' },\n  { id: '20', name: '黑料吃瓜' },\n  { id: '9', name: '国产私拍' },\n  { id: '8', name: '探花优选' },\n  { id: '16', name: '传媒出品' },\n  { id: '13', name: '撸管必看' },\n  { id: '7', name: '学生空姐' },\n  { id: '15', name: '玩转户外' },\n  { id: '14', name: '偷情乱伦' },\n  { id: '11', name: 'SM反差' },\n  { id: '25', name: '高清无码' },\n  { id: '10', name: '中文字幕' },\n  { id: '24', name: '颜值明星' },\n  { id: '21', name: 'AV解说' },\n  { id: '12', name: '男同鲜肉' },\n  { id: '5', name: '伪娘天菜' },\n  { id: '23', name: '主奴调教' },\n  { id: '22', name: '肌肉猛男' },\n];\n\n// 按路径取页面：逐条线路试开，状态码 2xx 且内容通过 validate 才算命中\n// (发布页/落地页也是 200, 只看状态码会被骗)。命中的线路会被记住并优先用。\nasync function fetchText(path, validate) {\n  const all = await getCandidates();\n  const ordered = goodBase && all.includes(goodBase)\n    ? [goodBase].concat(all.filter((b) => b !== goodBase))\n    : all;\n  let lastErr = null;\n  for (const base of ordered) {\n    try {\n      const r = await host.http.request({ url: base + path, headers: headersFor(base), timeout: 30 });\n      if (r.status >= 200 && r.status < 300) {\n        const body = r.body || '';\n        if (!validate || validate(body)) {\n          goodBase = base;\n          return { body, base };\n        }\n        lastErr = host.error('E_HTTP', '线路返回的不是站点页面：' + base + path);\n        continue;\n      }\n      lastErr = host.error('E_HTTP', '站点返回错误：HTTP ' + r.status + '：' + base + path);\n    } catch (e) {\n      lastErr = e;\n    }\n  }\n  throw lastErr || host.error('E_HTTP', '所有线路都不可用：' + path);\n}\n\nconst looksLikeList = (body) => body.includes('vod-item') || body.includes('/vodplay/');\nconst looksLikeDetail = (body) => body.includes('playlist_') || body.includes('/vodplay/');\nconst looksLikePlay = (body) => body.includes('player_aaaa');\n\nfunction parseItems(doc) {\n  const items = [];\n  const seen = {};\n  const cards = doc.select('.vod-item');\n  for (let i = 0; i < cards.length; i++) {\n    const card = cards[i];\n    const a = card.selectFirst('a[href^=\"/vodplay/\"]');\n    if (!a) continue;\n    const href = a.attr('href') || '';\n    const m = /\\/vodplay\\/(\\d+)-\\d+-\\d+\\.html/.exec(href);\n    if (!m) continue;\n    const id = m[1];\n    if (seen[id]) continue;\n    seen[id] = true;\n    const img = card.selectFirst('img');\n    let cover = '';\n    if (img) cover = img.attr('data-src') || img.attr('src') || '';\n    if (cover.indexOf('data:') === 0) cover = '';\n    let title = '';\n    const t = card.selectFirst('.rank-title');\n    if (t) title = t.text().trim();\n    if (!title && img) title = (img.attr('alt') || '').trim();\n    if (!title) continue;\n    let remarks = '';\n    const time = card.selectFirst('.pre-time');\n    if (time) remarks = time.text().trim();\n    items.push({ id, title, cover, remarks });\n  }\n  return items;\n}\n\nasync function listPage(path) {\n  const { body, base } = await fetchText(path, looksLikeList);\n  const doc = host.html.parse(body, base + path);\n  return parseItems(doc);\n}\n\nfunction typePath(id, page) {\n  return page <= 1 ? '/vodtype/' + id + '.html' : '/vodtype/' + id + '-' + page + '.html';\n}\n\nfunction searchPath(keyword, page) {\n  const kw = encodeURIComponent(keyword);\n  if (page <= 1) return '/vodsearch/' + kw + '-------------.html';\n  return '/vodsearch/' + kw + '----------' + page + '---.html';\n}\n\nexport default {\n  async home() {\n    const items = await listPage('/');\n    return { categories: CATEGORIES, items, hasMore: false };\n  },\n\n  async category({ id, page }) {\n    const p = page || 1;\n    const items = await listPage(typePath(id, p));\n    return { items, page: p, hasMore: items.length >= 10 };\n  },\n\n  async search({ keyword, page }) {\n    const p = page || 1;\n    const items = await listPage(searchPath(keyword, p));\n    return { items, page: p, hasMore: items.length >= 10 };\n  },\n\n  async detail({ id }) {\n    const path = '/voddetail/' + id + '.html';\n    const { body, base } = await fetchText(path, looksLikeDetail);\n    const doc = host.html.parse(body, base + path);\n    const h1 = doc.selectFirst('h1');\n    const title = h1 ? h1.text().trim() : '';\n    let cover = '';\n    const imgs = doc.select('img');\n    for (let i = 0; i < imgs.length; i++) {\n      const u = imgs[i].attr('data-src') || imgs[i].attr('src') || '';\n      if (u.indexOf('upload/vod') >= 0) { cover = u; break; }\n    }\n    let desc = '';\n    const dm = /<meta name=\"description\" content=\"([^\"]*)\"/.exec(body);\n    if (dm) {\n      const d = dm[1];\n      const k = d.indexOf('剧情:');\n      if (k >= 0) desc = d.slice(k + 3).trim();\n      if (desc === title) desc = '';\n    }\n    // 分线: #playlist_N 容器, h2 是 \"线路名-在线播放\"\n    const lines = [];\n    const boxes = doc.select('[id^=\"playlist_\"]');\n    for (let b = 0; b < boxes.length; b++) {\n      const box = boxes[b];\n      const h2 = box.selectFirst('h2');\n      let name = h2 ? h2.text().trim() : '';\n      name = name.replace(/-?在线播放$/, '').trim() || ('线路' + (b + 1));\n      const episodes = [];\n      const anchors = box.select('a[href^=\"/vodplay/\"]');\n      for (let j = 0; j < anchors.length; j++) {\n        const href = anchors[j].attr('href') || '';\n        const m = /\\/vodplay\\/\\d+-(\\d+)-(\\d+)\\.html/.exec(href);\n        if (!m) continue;\n        episodes.push({ id: m[1] + ':' + m[2], name: anchors[j].text().trim() || ('第' + m[2] + '集') });\n      }\n      if (episodes.length) lines.push({ name, episodes });\n    }\n    if (!lines.length) {\n      // 兜底: 详情页任意 vodplay 链接按 sid 分组\n      const bySid = {};\n      const anchors = doc.select('a[href^=\"/vodplay/\"]');\n      for (let j = 0; j < anchors.length; j++) {\n        const href = anchors[j].attr('href') || '';\n        const m = /\\/vodplay\\/\\d+-(\\d+)-(\\d+)\\.html/.exec(href);\n        if (!m) continue;\n        if (!bySid[m[1]]) bySid[m[1]] = [];\n        bySid[m[1]].push({ id: m[1] + ':' + m[2], name: anchors[j].text().trim() || ('第' + m[2] + '集') });\n      }\n      Object.keys(bySid).sort().forEach((sid, i) => lines.push({ name: '线路' + (i + 1), episodes: bySid[sid] }));\n    }\n    if (!lines.length) throw host.error('E_NOT_FOUND', '没有找到播放地址');\n    return { title, desc, tags: [], lines, cover };\n  },\n\n  async play({ episodeId, id }) {\n    const parts = String(episodeId || '1:1').split(':');\n    const sid = parts[0] || '1';\n    const nid = parts[1] || '1';\n    const path = '/vodplay/' + id + '-' + sid + '-' + nid + '.html';\n    const { body, base } = await fetchText(path, looksLikePlay);\n    const m = /var player_aaaa=(\\{.*?\\})<\\/script>/.exec(body);\n    if (!m) throw host.error('E_PARSE', '播放页没有 player_aaaa 数据');\n    let data;\n    try { data = JSON.parse(m[1]); } catch (e) { throw host.error('E_PARSE', 'player_aaaa 解析失败'); }\n    let u = data.url || '';\n    if (!u) throw host.error('E_NOT_FOUND', '播放地址为空');\n    if (data.encrypt === 1) { try { u = decodeURIComponent(u); } catch (e) {} }\n    else if (data.encrypt === 2) {\n      try { u = decodeURIComponent(host.codec.convert(u, 'base64', 'utf8')); } catch (e) {}\n    }\n    const isHls = /\\.m3u8($|\\?)/.test(u);\n    return { streams: [{ name: isHls ? 'HLS' : '播放', url: u, format: isHls ? 'hls' : 'mp4', headers: headersFor(base) }] };\n  },\n};\n"
 }
}