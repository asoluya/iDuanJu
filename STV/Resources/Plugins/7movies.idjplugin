{"manifest": {"schema": 1, "id": "com.idj.bundled.7movies", "name": "美剧", "version": "1.0.0", "author": {"name": "muse"}, "description": "7movies.ws 欧美电影电视剧：TMDB 元数据 + 直连 HLS 片源", "type": "video", "adult": false, "language": ["en"], "minAppVersion": "1.5", "entry": "main.js", "permissions": {"http": ["7movies.ws", "embed.vidrift.net", "image.tmdb.org"], "media": ["*.bigbang.cymru", "embed.vidrift.net"], "cloudflare": false, "storage": false, "login": false}, "capabilities": ["home", "category", "search", "detail", "play"], "settings": [], "integrity": {"files": {"main.js": "sha256-z6dap6hRpTCWanbu3+SqQA8ukPMYT6aCBV2/Z/Bv9KQ="}}}, "files": {"main.js": "// 美剧 (7movies.ws) — iDuanJu/muju 插件\n// 列表/详情: 站点 SSR HTML (.media-card + og 标签 + RSC 里的 seasons)\n// 播放: POST /api/playback-token 拿 JWT -> GET embed.vidrift.net/api/boot/<type>/<id>\n//       boot JSON 的 meta 里直接带签名 HLS (bigbangUrl / orionStreams / evionUrl / vexonUrl)\nconst BASE = 'https://7movies.ws';\nconst VIDRIFT = 'https://embed.vidrift.net';\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1';\n\nasync function req(url, opts) {\n  opts = opts || {};\n  const r = await host.http.request({\n    url: url,\n    method: opts.method || 'GET',\n    headers: Object.assign({ 'User-Agent': UA }, opts.headers || {}),\n    body: opts.body,\n    timeout: 30,\n  });\n  if (r.status < 200 || r.status >= 300) throw host.error('E_HTTP', '站点返回错误：HTTP ' + r.status + '：' + url);\n  return r;\n}\nasync function getText(url) { return (await req(url)).body; }\n\nfunction parseCards(html, pageUrl) {\n  const doc = host.html.parse(html, pageUrl);\n  const seen = {};\n  const items = [];\n  const cards = doc.select('[data-media-card]');\n  for (let i = 0; i < cards.length; i++) {\n    const card = cards[i];\n    const href = card.attr('data-navigation-href') || '';\n    const m = /^\\/(movie|tv)\\/(\\d+)$/.exec(href);\n    if (!m) continue;\n    const id = m[1] + ':' + m[2];\n    if (seen[id]) continue;\n    seen[id] = true;\n    const img = card.selectFirst('img');\n    let cover = img ? (img.attr('src') || img.attr('data-src') || '') : '';\n    if (cover.indexOf('//') === 0) cover = 'https:' + cover;\n    const titleEl = card.selectFirst('.card-copy h3 a') || card.selectFirst('h3 a') || card.selectFirst('h3');\n    const title = titleEl ? titleEl.text().trim() : '';\n    if (!title) continue;\n    const metaEl = card.selectFirst('.card-copy p');\n    let remarks = metaEl ? metaEl.text().trim() : '';\n    remarks = remarks.replace(/\\s*·\\s*(Movie|Show|TV)\\s*$/i, '').replace(/\\s+/g, ' ').trim();\n    items.push({ id: id, title: title, cover: cover, remarks: remarks });\n  }\n  return items;\n}\n\nfunction ogContent(doc, prop) {\n  const el = doc.selectFirst('meta[property=\"' + prop + '\"]');\n  return el ? (el.attr('content') || '') : '';\n}\n\n// 从 Next.js RSC 载荷里抠出 \\\"seasons\\\":[...] 并解析 (双层 JSON 解码)\nfunction extractSeasons(html) {\n  const key = '\\\\\"seasons\\\\\":[';\n  const start = html.indexOf(key);\n  if (start < 0) return [];\n  let i = start + key.length - 1; // 指向 [\n  let depth = 0;\n  let end = -1;\n  for (let j = i; j < html.length; j++) {\n    const c = html[j];\n    if (c === '\\\\') { j++; continue; }\n    if (c === '[') depth++;\n    else if (c === ']') { depth--; if (depth === 0) { end = j; break; } }\n  }\n  if (end < 0) return [];\n  const raw = html.slice(i, end + 1);\n  try {\n    const unescaped = JSON.parse('\"' + raw + '\"');\n    const arr = JSON.parse(unescaped);\n    return Array.isArray(arr) ? arr : [];\n  } catch (e) {\n    try { return JSON.parse(raw.replace(/\\\\\"/g, '\"')); } catch (e2) { return []; }\n  }\n}\n\nexport default {\n  async home() {\n    const html = await getText(BASE + '/');\n    const items = parseCards(html, BASE + '/').slice(0, 40);\n    return {\n      categories: [\n        { id: 'movies', name: '电影' },\n        { id: 'tv', name: '电视剧' },\n      ],\n      items: items,\n      hasMore: false,\n    };\n  },\n\n  async category({ id, page }) {\n    const type = id === 'tv' ? 'tv' : 'movie';\n    const url = BASE + '/api/discover?type=' + type + '&page=' + (page || 1);\n    const res = await req(url, { headers: { 'Accept': 'application/json' } });\n    let data = null;\n    try { data = typeof res.body === 'string' ? JSON.parse(res.body) : res.body; } catch (e) { data = null; }\n    const list = (data && data.items) || [];\n    const items = list.map(function (it) {\n      return {\n        id: (it.mediaType || type) + ':' + it.id,\n        title: it.title || '',\n        cover: it.poster || '',\n        remarks: ('★ ' + (it.rating || '') + ' · ' + (it.year || '')).trim(),\n      };\n    }).filter(function (it) { return it.title; });\n    return { items: items, page: page, hasMore: !!data && page < (data.totalPages || page) };\n  },\n\n  async search({ keyword, page }) {\n    if (page > 1) return { items: [], page: page, hasMore: false };\n    const url = BASE + '/api/search?q=' + encodeURIComponent(keyword);\n    const res = await req(url, { headers: { 'Accept': 'application/json' } });\n    let data = null;\n    try { data = typeof res.body === 'string' ? JSON.parse(res.body) : res.body; } catch (e) { data = null; }\n    const list = (data && data.results) || [];\n    const items = list.map(function (it) {\n      return {\n        id: (it.mediaType || 'movie') + ':' + it.id,\n        title: it.title || '',\n        cover: it.poster || '',\n        remarks: ('★ ' + (it.rating || '') + ' · ' + (it.year || '')).trim(),\n      };\n    }).filter(function (it) { return it.title; });\n    return { items: items, page: page, hasMore: false };\n  },\n\n  async detail({ id }) {\n    const parts = String(id).split(':');\n    const type = parts[0] === 'tv' ? 'tv' : 'movie';\n    const tid = parts[1];\n    const url = BASE + '/' + type + '/' + tid;\n    const html = await getText(url);\n    const doc = host.html.parse(html, url);\n    let title = ogContent(doc, 'og:title').replace(/\\s*—\\s*Watch on 7Movies\\s*$/, '').trim();\n    const cover = ogContent(doc, 'og:image');\n    const desc = ogContent(doc, 'og:description');\n    const ym = /\\((\\d{4})\\)\\s*$/.exec(title);\n    const tags = [];\n    if (ym) { tags.push(ym[1]); title = title.replace(/\\s*\\(\\d{4}\\)\\s*$/, '').trim(); }\n    tags.push(type === 'tv' ? '电视剧' : '电影');\n    if (type === 'movie') {\n      return {\n        title: title, desc: desc, tags: tags, cover: cover,\n        lines: [{ name: '正片', episodes: [{ id: '1:1', name: '播放' }] }],\n      };\n    }\n    const seasons = extractSeasons(html);\n    const lines = [];\n    for (let i = 0; i < seasons.length; i++) {\n      const s = seasons[i];\n      const n = s.season_number;\n      const cnt = s.episode_count || 0;\n      if (typeof n !== 'number' || cnt <= 0) continue;\n      const eps = [];\n      for (let e = 1; e <= cnt; e++) eps.push({ id: n + ':' + e, name: '第' + e + '集' });\n      lines.push({ name: n === 0 ? (s.name || '特辑') : '第' + n + '季', episodes: eps });\n    }\n    if (!lines.length) {\n      // seasons 抠不到时退化: 至少给第 1 季 1 集, 播放接口会校验\n      lines.push({ name: '第1季', episodes: [{ id: '1:1', name: '第1集' }] });\n    }\n    return { title: title, desc: desc, tags: tags, cover: cover, lines: lines };\n  },\n\n  async play({ episodeId, id }) {\n    const parts = String(id).split(':');\n    const type = parts[0] === 'tv' ? 'tv' : 'movie';\n    const tid = parts[1];\n    const ep = String(episodeId || '1:1').split(':');\n    const season = parseInt(ep[0], 10) || 1;\n    const episode = parseInt(ep[1], 10) || 1;\n    // 1) 播放令牌\n    const watchUrl = BASE + '/' + type + '/' + tid + '/watch' + (type === 'tv' ? '?season=' + season + '&episode=' + episode : '');\n    const tokRes = await req(BASE + '/api/playback-token', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        'Origin': BASE,\n        'Referer': watchUrl,\n        'Sec-Fetch-Site': 'same-origin',\n        'Sec-Fetch-Mode': 'cors',\n        'Sec-Fetch-Dest': 'empty',\n        'Accept': '*/*',\n      },\n      body: JSON.stringify({ tmdbId: Number(tid), type: type, season: season, episode: episode }),\n    });\n    let token = '';\n    try { token = (typeof tokRes.body === 'string' ? JSON.parse(tokRes.body) : tokRes.body).token || ''; } catch (e) { token = ''; }\n    if (!token) throw host.error('E_AUTH', '获取播放令牌失败');\n    // 2) vidrift boot\n    const bootPath = '/api/boot/' + type + '/' + tid + (type === 'tv' ? '/' + season + '/' + episode : '');\n    const bootUrl = VIDRIFT + bootPath + '?type=' + type + '&id=' + tid + '&season=' + season + '&episode=' + episode + '&source=0&shell=1&token=' + encodeURIComponent(token);\n    const bootRes = await req(bootUrl, {\n      headers: {\n        'x-embed-parent': BASE,\n        'Referer': VIDRIFT + '/embed2/play',\n        'Accept': 'application/json',\n      },\n    });\n    let boot = null;\n    try { boot = typeof bootRes.body === 'string' ? JSON.parse(bootRes.body) : bootRes.body; } catch (e) { boot = null; }\n    const meta = (boot && boot.meta) || {};\n    const streams = [];\n    if (meta.bigbangUrl) streams.push({ name: 'BigBang', url: meta.bigbangUrl, format: 'hls' });\n    const orion = Array.isArray(meta.orionStreams) ? meta.orionStreams : [];\n    let cookie = '';\n    try {\n      const sc = bootRes.headers && (bootRes.headers['set-cookie'] || bootRes.headers['Set-Cookie']);\n      if (sc) cookie = String(sc).split(';')[0];\n    } catch (e) { cookie = ''; }\n    for (let i = 0; i < orion.length; i++) {\n      const s = orion[i];\n      if (!s || !s.url) continue;\n      const u = s.url.indexOf('http') === 0 ? s.url : VIDRIFT + s.url;\n      const headers = { 'Referer': VIDRIFT + '/' };\n      if (cookie) headers['Cookie'] = cookie;\n      streams.push({ name: s.name || 'Orion', url: u, format: 'hls', headers: headers });\n    }\n    if (meta.evionUrl) streams.push({ name: 'Evion', url: meta.evionUrl, format: 'hls' });\n    if (meta.vexonUrl) streams.push({ name: 'Vexon', url: meta.vexonUrl, format: 'hls' });\n    if (meta.selfhostUrl) streams.push({ name: '自营', url: meta.selfhostUrl, format: 'hls' });\n    if (!streams.length) {\n      if (meta.unreleased || meta.inCinemas) throw host.error('E_EMPTY', '该片尚未正式上映/更新，暂无片源');\n      throw host.error('E_EMPTY', '该片暂无可用片源');\n    }\n    return { streams: streams };\n  },\n};\n"}}