{"manifest": {"schema": 1, "id": "com.idj.bundled.134x", "name": "134X", "version": "1.0.2", "author": {"name": "asoluya"}, "description": "134X 黄推长视频：X（Twitter）上 1 小时以上的长视频精选", "type": "video", "adult": true, "language": ["zh"], "minAppVersion": "1.5", "entry": "main.js", "permissions": {"http": ["134x.com", "*.134x.com", "video.twimg.com", "pbs.twimg.com"], "media": ["video.twimg.com", "pbs.twimg.com"], "cloudflare": false, "storage": false, "login": false}, "capabilities": ["home", "category", "search", "detail", "play"], "settings": [], "integrity": {"files": {"main.js": "sha256-4YJ28OTX7VSTvpejJ8g+dZcIw5VUdQ/4jIj2ZknqysQ="}}}, "files": {"main.js": "// 134X (134x.com) plugin for muju / iDuanJu\n// The site is a TanStack Start SPA; data comes from GET server functions\n// under /_serverFn/<id> with a seroval-encoded `payload` query param.\n// The endpoints 403 unless the request carries browser-like\n// Origin / sec-fetch headers (cookies are NOT required).\n// NOTE: the app truncates item ids at 300 chars, so ids stay short\n// (the X tweet id); detail/play fetch the full record by id.\n\nconst SITE = 'https://134x.com';\nconst UA = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.5 Mobile/15E148 Safari/604.1';\n\nconst FN_TIMELINE = '7cd2fdc202217221aea24ce98c8911133744658e2b912656f645ea53849d6f17';\nconst FN_SEARCH = '51bd2bec8cfd50e218d50fb96a0f5a94bbdeb6e6835dec38fab33818af78324d';\nconst FN_DETAIL = 'e477157db52787f926da12773bc16f587104ce81dd6ff10db4dcef655ce7cf37';\n\nconst CATEGORIES = [\n  { id: 'latest', name: '最新' },\n  { id: 'popular', name: '热门' },\n  { id: 'featured', name: '精选' }\n];\n\n// ---------- seroval encode (subset: string / number / flat object) ----------\nfunction leafNode(v) {\n  if (typeof v === 'string') return { t: 1, s: v };\n  if (typeof v === 'number') return { t: 0, s: v };\n  if (typeof v === 'boolean') return { t: 2, s: v ? 3 : 1 };\n  throw new Error('unsupported leaf type: ' + typeof v);\n}\n\nfunction encodePayload(data) {\n  const keys = Object.keys(data);\n  const dataNode = {\n    t: 10, i: 1,\n    p: { k: keys, v: keys.map((k) => leafNode(data[k])) },\n    o: 0\n  };\n  const root = { t: 10, i: 0, p: { k: ['data'], v: [dataNode] }, o: 0 };\n  return JSON.stringify({ t: root, f: 127, m: [] });\n}\n\n// ---------- seroval decode (subset used by these endpoints) ----------\nfunction decodeNode(n) {\n  if (n === null || typeof n !== 'object') return n;\n  switch (n.t) {\n    case 0: return n.s; // number\n    case 1: return n.s; // string / date-as-string\n    case 2: return n.s === 3; // boolean (best effort; not relied upon)\n    case 9: return (n.a || []).map(decodeNode); // array\n    case 10: { // object\n      const out = {};\n      const p = n.p || {};\n      const ks = p.k || [];\n      const vs = p.v || [];\n      for (let i = 0; i < ks.length; i++) out[ks[i]] = decodeNode(vs[i]);\n      return out;\n    }\n    default: return null;\n  }\n}\n\nfunction decodeResponse(body) {\n  const env = JSON.parse(body);\n  const root = decodeNode(env);\n  if (!root || typeof root !== 'object') throw host.error('E_PARSE', '接口返回无法解析');\n  if (root.error) throw host.error('E_API', '接口返回错误');\n  return root.result;\n}\n\n// ---------- HTTP ----------\nasync function callFn(fnId, data, referer) {\n  const payload = encodeURIComponent(encodePayload(data));\n  const url = SITE + '/_serverFn/' + fnId + '?payload=' + payload;\n  const res = await host.http.request({\n    url,\n    headers: {\n      'User-Agent': UA,\n      'Referer': referer || SITE + '/',\n      'Origin': SITE,\n      'sec-fetch-site': 'same-origin',\n      'sec-fetch-mode': 'cors',\n      'sec-fetch-dest': 'empty',\n      'x-tsr-serverFn': 'true',\n      'Accept': 'application/x-tss-framed, application/x-ndjson, application/json'\n    },\n    timeout: 30\n  });\n  if (res.status !== 200) {\n    throw host.error('E_HTTP', '站点返回错误：HTTP ' + res.status);\n  }\n  return decodeResponse(res.body);\n}\n\n// ---------- cursor pagination ----------\n// key -> cursor to send for that page; key + '#end' marks the last page.\nconst cursors = {};\n\nasync function fetchPage(fnId, key, page, makeData, referer) {\n  if (page > 1 && cursors[key + '#end']) return { tweets: [], done: true };\n  const data = makeData(page > 1 ? cursors[key + ':' + page] : undefined);\n  data.page = page;\n  const result = await callFn(fnId, data, referer);\n  const tweets = (result && result.tweets) || [];\n  if (result && result.nextCursor) {\n    cursors[key + ':' + (page + 1)] = result.nextCursor;\n  } else {\n    cursors[key + '#end'] = true;\n  }\n  return { tweets, done: !result || !result.nextCursor };\n}\n\n// ---------- detail fetch (by X tweet id), cached across detail/play ----------\nconst tweetCache = {};\n\nasync function fetchTweet(tweetId) {\n  if (tweetCache[tweetId]) return tweetCache[tweetId];\n  const result = await callFn(FN_DETAIL, { tweetId }, SITE + '/video/' + tweetId);\n  const tw = result && result.tweet;\n  if (!tw) throw host.error('E_NOT_FOUND', '条目不存在或已被删除');\n  tweetCache[tweetId] = tw;\n  return tw;\n}\n\n// ---------- poster enrichment ----------\n// List payloads carry no poster; the detail endpoint has it. Fetch it per\n// item (pool of 8) and cache the full record so detail/play stay instant.\n// Failures just leave the cover empty — the list itself must never fail.\nasync function enrichPosters(tweets) {\n  const need = tweets.filter((t) => !t.posterUrl && (t.tweetId || t.id));\n  let idx = 0;\n  async function worker() {\n    while (idx < need.length) {\n      const tw = need[idx++];\n      try {\n        const full = await fetchTweet(tw.tweetId || tw.id);\n        if (full && full.posterUrl) tw.posterUrl = full.posterUrl;\n      } catch (e) { /* keep empty cover */ }\n    }\n  }\n  const workers = [];\n  for (let i = 0; i < Math.min(8, need.length); i++) workers.push(worker());\n  await Promise.all(workers);\n}\n\n// ---------- item shaping ----------\nfunction fmtDuration(ms) {\n  if (!ms) return '';\n  const sec = Math.floor(ms / 1000);\n  const h = Math.floor(sec / 3600);\n  const m = Math.floor((sec % 3600) / 60);\n  const s = sec % 60;\n  const mm = (m < 10 ? '0' : '') + m;\n  const ss = (s < 10 ? '0' : '') + s;\n  return h > 0 ? h + ':' + mm + ':' + ss : mm + ':' + ss;\n}\n\nfunction cleanText(t) {\n  return (t || '').replace(/\\\\n/g, '\\n').trim();\n}\n\nfunction titleOf(tw) {\n  const text = cleanText(tw.text);\n  const first = text.split('\\n')[0].trim();\n  if (first) return first.length > 80 ? first.slice(0, 80) : first;\n  return tw.name || '未命名';\n}\n\nfunction tagsOf(tw) {\n  const tags = [];\n  const re = /#([^\\s#]+)/g;\n  let m;\n  const text = cleanText(tw.text);\n  while ((m = re.exec(text)) !== null && tags.length < 3) tags.push(m[1]);\n  return tags;\n}\n\nfunction toItem(tw) {\n  return {\n    id: tw.tweetId || tw.id,\n    title: titleOf(tw),\n    cover: tw.posterUrl || '',\n    remarks: fmtDuration(tw.durationMillis),\n    tags: tagsOf(tw)\n  };\n}\n\n// ---------- plugin contract ----------\nexport default {\n  async home() {\n    const { tweets, done } = await fetchPage(FN_TIMELINE, 'cat:latest', 1, () => ({}), SITE + '/');\n    await enrichPosters(tweets);\n    return { categories: CATEGORIES, items: tweets.map(toItem), hasMore: !done };\n  },\n\n  async category({ id, page }) {\n    const cat = CATEGORIES.find((c) => c.id === id) || CATEGORIES[0];\n    const current = page && page > 0 ? Math.floor(page) : 1;\n    const { tweets, done } = await fetchPage(FN_TIMELINE, 'cat:' + cat.id, current, (cursor) => {\n      const d = {};\n      if (cat.id !== 'latest') d.ranking = cat.id;\n      if (cursor) { d.cursor = cursor; d.direction = 'next'; }\n      return d;\n    }, SITE + '/');\n    await enrichPosters(tweets);\n    return { items: tweets.map(toItem), page: current, hasMore: !done };\n  },\n\n  async search({ keyword, page }) {\n    const q = (keyword || '').trim();\n    const current = page && page > 0 ? Math.floor(page) : 1;\n    if (!q) {\n      const homeRes = await this.home();\n      return { items: homeRes.items, page: 1, hasMore: homeRes.hasMore };\n    }\n    const { tweets, done } = await fetchPage(FN_SEARCH, 'q:' + q, current, (cursor) => {\n      const d = { query: q };\n      if (cursor) { d.cursor = cursor; d.direction = 'next'; }\n      return d;\n    }, SITE + '/search');\n    await enrichPosters(tweets);\n    return { items: tweets.map(toItem), page: current, hasMore: !done };\n  },\n\n  async detail({ id }) {\n    const tw = await fetchTweet(id);\n    const title = titleOf(tw);\n    const lines = [\n      '作者：' + (tw.name || '') + (tw.screenName ? ' (@' + tw.screenName + ')' : ''),\n      tw.durationMillis ? '时长：' + fmtDuration(tw.durationMillis) : '',\n      tw.playTimes ? '播放：' + tw.playTimes : '',\n      tw.postAt ? '发布：' + String(tw.postAt).slice(0, 10) : '',\n      '',\n      cleanText(tw.text),\n      '',\n      '原推：https://x.com/' + (tw.screenName || '') + '/status/' + (tw.tweetId || '')\n    ].filter((x) => x !== '');\n    const result = {\n      title,\n      desc: lines.join('\\n'),\n      tags: tagsOf(tw),\n      lines: [{ name: '134X', episodes: [{ id: tw.tweetId || id, name: title }] }]\n    };\n    if (tw.posterUrl) result.cover = tw.posterUrl;\n    return result;\n  },\n\n  async play({ episodeId, id }) {\n    const tw = await fetchTweet(episodeId || id);\n    const media = tw.media || '';\n    const streams = [];\n    const hls = (tw.hlsUrls && media && tw.hlsUrls[media]) || '';\n    if (hls) {\n      streams.push({ name: 'HLS 自适应', url: hls, format: 'hls', headers: { 'User-Agent': UA, 'Referer': SITE + '/' } });\n    }\n    const variants = (tw.videoVariants && media && tw.videoVariants[media]) || [];\n    const sorted = variants.slice().sort((a, b) => (b.bitrate || 0) - (a.bitrate || 0));\n    for (const v of sorted) {\n      if (v && v.url) {\n        streams.push({\n          name: (v.width && v.height) ? v.width + '×' + v.height : 'MP4',\n          url: v.url,\n          format: 'mp4',\n          headers: { 'User-Agent': UA, 'Referer': SITE + '/' }\n        });\n      }\n    }\n    if (media && !streams.some((s) => s.url === media)) {\n      streams.push({ name: '原画', url: media, format: 'mp4', headers: { 'User-Agent': UA, 'Referer': SITE + '/' } });\n    }\n    if (streams.length === 0) throw host.error('E_NO_MEDIA', '该条目没有可播放的视频');\n    return { streams };\n  }\n};\n"}}